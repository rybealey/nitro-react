+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the photos inside one album, newest-added first. Shared albums
+// mix photos from every contributor, so each entry carries its owner.
+export interface RpAlbumPhoto
+{
+    id: number;
+    url: string;
+    timestamp: number;
+    ownerId: number;
+    ownerName: string;
+}
+
+export class RpAlbumPhotosParser implements IMessageParser
+{
+    private _albumId: number;
+    private _photos: RpAlbumPhoto[];
+
+    public flush(): boolean
+    {
+        this._albumId = 0;
+        this._photos = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._albumId = wrapper.readInt();
+        this._photos = [];
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            this._photos.push({
+                id: wrapper.readInt(),
+                url: wrapper.readString(),
+                timestamp: wrapper.readInt(),
+                ownerId: wrapper.readInt(),
+                ownerName: wrapper.readString()
+            });
+
+            count--;
+        }
+
+        return true;
+    }
+
+    public get albumId(): number
+    {
+        return this._albumId;
+    }
+
+    public get photos(): RpAlbumPhoto[]
+    {
+        return this._photos;
+    }
+}
+
+export class RpAlbumPhotosEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpAlbumPhotosParser);
+    }
+
+    public getParser(): RpAlbumPhotosParser
+    {
+        return this.parser as RpAlbumPhotosParser;
+    }
+}
