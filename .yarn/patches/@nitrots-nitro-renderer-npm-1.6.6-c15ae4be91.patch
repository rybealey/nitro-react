+
+// PixelRP: live message receipt for the phone's Messages app — a friend
+// received (delivered) or opened (read) the messages you sent them.
+export class RpMessengerReceiptParser implements IMessageParser
+{
+    public static DELIVERED: number = 1;
+    public static READ: number = 2;
+
+    private _friendId: number;
+    private _type: number;
+
+    public flush(): boolean
+    {
+        this._friendId = 0;
+        this._type = 0;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._friendId = wrapper.readInt();
+        this._type = wrapper.readInt();
+
+        return true;
+    }
+
+    public get friendId(): number
+    {
+        return this._friendId;
+    }
+
+    public get type(): number
+    {
+        return this._type;
+    }
+}
+
+export class RpMessengerReceiptEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpMessengerReceiptParser);
+    }
+
+    public getParser(): RpMessengerReceiptParser
+    {
+        return this.parser as RpMessengerReceiptParser;
+    }
+}
diff --git a/src/nitro/communication/messages/incoming/RpPhotoListEvent.ts b/src/nitro/communication/messages/incoming/RpPhotoListEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69e3971cffa2946bd6b7262aa3752cd98cffed98
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpPhotoListEvent.ts
@@ -0,0 +1,66 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the player's photo library for the phone's Photos app — every
+// camera photo they've saved, newest first. `published` marks photos that
+// are visible on the website's Photos page.
+export interface RpPhotoListItem
+{
+    id: number;
+    url: string;
+    timestamp: number;
+    published: boolean;
+}
+
+export class RpPhotoListParser implements IMessageParser
+{
+    private _photos: RpPhotoListItem[];
+
+    public flush(): boolean
+    {
+        this._photos = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._photos = [];
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            this._photos.push({
+                id: wrapper.readInt(),
+                url: wrapper.readString(),
+                timestamp: wrapper.readInt(),
+                published: wrapper.readBoolean()
+            });
+
+            count--;
+        }
+
+        return true;
+    }
+
+    public get photos(): RpPhotoListItem[]
+    {
+        return this._photos;
+    }
+}
+
+export class RpPhotoListEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpPhotoListParser);
+    }
+
+    public getParser(): RpPhotoListParser
+    {
+        return this.parser as RpPhotoListParser;
+    }
+}
