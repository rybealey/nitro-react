diff --git a/src/nitro/communication/messages/incoming/RpStatsEvent.ts b/src/nitro/communication/messages/incoming/RpStatsEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..423985ca59c827adbb15bf3bbc5c1bc784793591
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpStatsEvent.ts
@@ -0,0 +1,84 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: RP stats (health/energy for the player HUD) pushed by the server
+// per room unit, keyed by the unit's roomIndex (virtual id). Sent on room
+// entry and whenever a stat changes.
+export class RpStatsParser implements IMessageParser
+{
+    private _roomIndex: number;
+    private _health: number;
+    private _healthMax: number;
+    private _energy: number;
+    private _energyMax: number;
+    private _aggression: number;
+
+    public flush(): boolean
+    {
+        this._roomIndex = -1;
+        this._health = 0;
+        this._healthMax = 0;
+        this._energy = 0;
+        this._energyMax = 0;
+        this._aggression = 0;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._roomIndex = wrapper.readInt();
+        this._health = wrapper.readInt();
+        this._healthMax = wrapper.readInt();
+        this._energy = wrapper.readInt();
+        this._energyMax = wrapper.readInt();
+        this._aggression = wrapper.readInt();
+
+        return true;
+    }
+
+    public get roomIndex(): number
+    {
+        return this._roomIndex;
+    }
+
+    public get health(): number
+    {
+        return this._health;
+    }
+
+    public get healthMax(): number
+    {
+        return this._healthMax;
+    }
+
+    public get energy(): number
+    {
+        return this._energy;
+    }
+
+    public get energyMax(): number
+    {
+        return this._energyMax;
+    }
+
+    public get aggression(): number
+    {
+        return this._aggression;
+    }
+}
+
+export class RpStatsEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpStatsParser);
+    }
+
+    public getParser(): RpStatsParser
+    {
+        return this.parser as RpStatsParser;
+    }
+}
