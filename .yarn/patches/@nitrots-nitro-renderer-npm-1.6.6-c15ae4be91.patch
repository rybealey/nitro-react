new file mode 100644
index 0000000000000000000000000000000000000000..81c82054c5338ebaaec08a8124a9afb12c7c8356
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpPhotoListEvent.ts
@@ -0,0 +1,85 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the player's photo library for the phone's Photos app — every
+// camera photo they've saved, newest first. `published` marks photos that
+// are visible on the website's Photos page.
+export interface RpPhotoListItem
+{
+    id: number;
+    url: string;
+    timestamp: number;
+    published: boolean;
+    // 'camera' | 'screenshot' | 'saved' | '' (legacy rows from before
+    // metadata existed)
+    source: string;
+    // The room's name snapshotted at capture time ('' outside a room)
+    roomName: string;
+    // Players inside a phone camera shot's frame (empty otherwise)
+    taggedUsers: string[];
+}
+
+export class RpPhotoListParser implements IMessageParser
+{
+    private _photos: RpPhotoListItem[];
+
+    public flush(): boolean
+    {
+        this._photos = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._photos = [];
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            const id = wrapper.readInt();
+            const url = wrapper.readString();
+            const timestamp = wrapper.readInt();
+            const published = wrapper.readBoolean();
+            const source = wrapper.readString();
+            const roomName = wrapper.readString();
+            const taggedUsers: string[] = [];
+
+            let userCount = wrapper.readInt();
+
+            while(userCount > 0)
+            {
+                taggedUsers.push(wrapper.readString());
+
+                userCount--;
+            }
+
+            this._photos.push({ id, url, timestamp, published, source, roomName, taggedUsers });
+
+            count--;
+        }
+
+        return true;
+    }
+
+    public get photos(): RpPhotoListItem[]
+    {
+        return this._photos;
+    }
+}
+
+export class RpPhotoListEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpPhotoListParser);
+    }
+
+    public getParser(): RpPhotoListParser
+    {
+        return this.parser as RpPhotoListParser;
+    }
+}
