+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: result of a VIP diamonds store purchase attempt.
+export class DiamondsStorePurchaseResultParser implements IMessageParser
+{
+    public static OK: number = 0;
+    public static NOT_ENOUGH_DIAMONDS: number = 1;
+    public static BACKPACK_FULL: number = 2;
+
+    private _status: number;
+    private _itemKey: string;
+
+    public flush(): boolean
+    {
+        this._status = 0;
+        this._itemKey = '';
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._status = wrapper.readInt();
+        this._itemKey = wrapper.readString();
+
+        return true;
+    }
+
+    public get status(): number
+    {
+        return this._status;
+    }
+
+    public get itemKey(): string
+    {
+        return this._itemKey;
+    }
+}
+
+export class DiamondsStorePurchaseResultEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, DiamondsStorePurchaseResultParser);
+    }
+
+    public getParser(): DiamondsStorePurchaseResultParser
+    {
+        return this.parser as DiamondsStorePurchaseResultParser;
+    }
+}
