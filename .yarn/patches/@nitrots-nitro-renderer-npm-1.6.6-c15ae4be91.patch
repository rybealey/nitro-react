new file mode 100644
index 0000000000000000000000000000000000000000..4abfa11f6fdbc0222e5fb0403789207c2c24ec88
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpInventoryEvent.ts
@@ -0,0 +1,54 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the player's RP backpack contents (carry slots), pushed at login
+// and after every inventory change.
+export class RpInventoryParser implements IMessageParser
+{
+    private _items: { slot: number, item: string, count: number }[];
+
+    public flush(): boolean
+    {
+        this._items = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._items = [];
+
+        const total = wrapper.readInt();
+
+        for(let i = 0; i < total; i++)
+        {
+            const slot = wrapper.readInt();
+            const item = wrapper.readString();
+            const count = wrapper.readInt();
+
+            this._items.push({ slot, item, count });
+        }
+
+        return true;
+    }
+
+    public get items(): { slot: number, item: string, count: number }[]
+    {
+        return this._items;
+    }
+}
+
+export class RpInventoryEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpInventoryParser);
+    }
+
+    public getParser(): RpInventoryParser
+    {
+        return this.parser as RpInventoryParser;
+    }
+}
