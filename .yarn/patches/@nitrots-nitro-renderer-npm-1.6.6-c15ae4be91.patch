diff --git a/src/nitro/communication/messages/outgoing/RpSavePhotoComposer.ts b/src/nitro/communication/messages/outgoing/RpSavePhotoComposer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..20196cf5b46c989a0da1635821cbd5e312e200f4
--- /dev/null
+++ b/src/nitro/communication/messages/outgoing/RpSavePhotoComposer.ts
@@ -0,0 +1,33 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: save a phone-camera room shot straight into the player's photo
+// library (no inventory furni). Carries the ids of the players inside the
+// frame (validated server-side against the room roster), then the PNG bytes
+// packed RenderRoom-style.
+export class RpSavePhotoComposer implements IMessageComposer<any[]>
+{
+    private _data: any[];
+
+    constructor(taggedUserIds: number[])
+    {
+        this._data = [ taggedUserIds.length, ...taggedUserIds ];
+    }
+
+    public assignBase64(base64: string): void
+    {
+        const base64Data = base64.split(',')[1];
+        const binaryData = Uint8Array.from(atob(base64Data), c => c.charCodeAt(0));
+
+        this._data.push(binaryData.byteLength, binaryData.buffer);
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        this._data = [];
+    }
+}
