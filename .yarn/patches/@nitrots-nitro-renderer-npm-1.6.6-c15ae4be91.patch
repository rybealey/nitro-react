+        return this._usernameColor;
+    }
+
+    public get icon(): string
+    {
+        return this._icon;
+    }
+
+    public get iconColor(): string
+    {
+        return this._iconColor;
+    }
+}
+
+export class RpUiSettingsEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpUiSettingsParser);
+    }
+
+    public getParser(): RpUiSettingsParser
+    {
+        return this.parser as RpUiSettingsParser;
+    }
+}
