diff --git a/src/room/renderer/PixelRPSystem11.ts b/src/room/renderer/PixelRPSystem11.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b1dac395fe00bd8e8de0d30b25128f056567d61
--- /dev/null
+++ b/src/room/renderer/PixelRPSystem11.ts
@@ -0,0 +1,659 @@
+export enum PixelRPSystem11Relation
+{
+    UNKNOWN = 0,
+    ALIGNED = 1,
+    BEHIND = 2,
+    AHEAD = 3,
+    DIVERGED = 4
+}
+
+export interface PixelRPMovementSample
+{
+    id: number;
+    moving: boolean;
+    sx: number;
+    sy: number;
+    sz: number;
+    gx: number;
+    gy: number;
+    gz: number;
+    phase: number;
+    interval: number;
+    x: number;
+    y: number;
+    z: number;
+}
+
+export interface PixelRPSystem11Target
+{
+    x: number;
+    y: number;
+    z: number;
+}
+
+interface PixelRPRouteEdge
+{
+    sx: number;
+    sy: number;
+    sz: number;
+    gx: number;
+    gy: number;
+    gz: number;
+    slot: number;
+    startedAt: number;
+    changedAt: number;
+}
+
+interface PixelRPRouteHistory
+{
+    id: number;
+    updatedAt: number;
+    moving: boolean;
+    phase: number;
+    interval: number;
+    x: number;
+    y: number;
+    z: number;
+    walkSince: number;
+    sequence: number;
+    current: PixelRPRouteEdge;
+    previous: PixelRPRouteEdge;
+    edges: PixelRPRouteEdge[];
+}
+
+interface PixelRPSlotProposal
+{
+    relation: PixelRPSystem11Relation;
+    masterEdge: PixelRPRouteEdge;
+    joinerEdge: PixelRPRouteEdge;
+    timingDelta: number;
+    reason: string;
+}
+
+interface PixelRPPendingAdoption
+{
+    pairKey: string;
+    masterId: number;
+    joinerId: number;
+    joinerSlotShift: number;
+    masterSequenceSeen: number;
+    joinerSequenceSeen: number;
+}
+
+interface PixelRPSystem11Session
+{
+    masterId: number;
+    joinerId: number;
+    pairKey: string;
+    joinerSlotShift: number;
+    relation: PixelRPSystem11Relation;
+    masterSequenceSeen: number;
+    joinerSequenceSeen: number;
+    renderMasterSlot: number;
+    renderJoinerEdge: PixelRPRouteEdge;
+    lastSharedPhase: number;
+    lastPhaseAt: number;
+    lastRenderedX: number;
+    lastRenderedY: number;
+    lastRenderedZ: number;
+    lastRenderedAt: number;
+    stoppedSince: number;
+}
+
+interface PixelRPReengagementBlock
+{
+    pairKey: string;
+    joinerId: number;
+    joinerSequence: number;
+}
+
+/**
+ * System 11 uses MASTER-authoritative movement slots. Every real movement edge
+ * is queued and receives a permanent local slot before pairing. A pair adds one
+ * fixed integer mapping between those local slot timelines. JOINER may render
+ * only a real queued edge assigned to MASTER's current slot, using MASTER's
+ * native smooth phase. There is no convergence, speed correction or blend.
+ */
+export class PixelRPSystem11
+{
+    private static readonly DEFAULT_INTERVAL = 530;
+    private static readonly EDGE_QUEUE_SIZE = 12;
+    private static readonly EDGE_STALE_MS = 1200;
+    private static readonly STOP_GRACE_MS = 160;
+    private static readonly SLOT_BOUNDARY_UNCERTAINTY = 0.08;
+    private static readonly MAX_SLOT_OFFSET = 1;
+    private static readonly MAX_ADOPTION_DISCREPANCY = 0.08;
+    private static readonly MAX_CONTINUITY_DISCREPANCY = 0.08;
+    // Diagnostic pass: event-only state instrumentation. No render-frame log.
+    private static readonly INSTRUMENT_TRANSITIONS = true;
+
+    private readonly _history = new Map<number, PixelRPRouteHistory>();
+    private _session: PixelRPSystem11Session = null;
+    private _pendingAdoption: PixelRPPendingAdoption = null;
+    private _reengagementBlock: PixelRPReengagementBlock = null;
+
+    public record(sample: PixelRPMovementSample, now: number): void
+    {
+        let history = this._history.get(sample.id);
+
+        if(!history)
+        {
+            history = {
+                id: sample.id,
+                updatedAt: now,
+                moving: sample.moving,
+                phase: sample.phase,
+                interval: sample.interval,
+                x: sample.x,
+                y: sample.y,
+                z: sample.z,
+                walkSince: sample.moving ? now : -1,
+                sequence: 0,
+                current: null,
+                previous: null,
+                edges: []
+            };
+
+            this._history.set(sample.id, history);
+        }
+
+        if(sample.moving)
+        {
+            const interval = (sample.interval > 0) ? sample.interval : PixelRPSystem11.DEFAULT_INTERVAL;
+            const candidate: PixelRPRouteEdge = {
+                sx: Math.round(sample.sx),
+                sy: Math.round(sample.sy),
+                sz: sample.sz,
+                gx: Math.round(sample.gx),
+                gy: Math.round(sample.gy),
+                gz: sample.gz,
+                slot: history.current ? (history.current.slot + 1) : 0,
+                startedAt: (now - (Math.min(1, Math.max(0, sample.phase)) * interval)),
+                changedAt: now
+            };
+
+            if(!history.current)
+            {
+                history.current = candidate;
+                history.edges.push(candidate);
+                history.sequence++;
+            }
+            else if(!this.edgeEquals(history.current, candidate))
+            {
+                history.previous = this.edgesContiguous(history.current, candidate) ? history.current : null;
+                history.current = candidate;
+                history.edges.push(candidate);
+                history.sequence++;
+
+                if(history.edges.length > PixelRPSystem11.EDGE_QUEUE_SIZE)
+                {
+                    history.edges.splice(0, (history.edges.length - PixelRPSystem11.EDGE_QUEUE_SIZE));
+                }
+            }
+
+            if(history.walkSince < 0) history.walkSince = now;
+        }
+        else
+        {
+            history.walkSince = -1;
+        }
+
+        history.updatedAt = now;
+        history.moving = sample.moving;
+        history.phase = Math.min(1, Math.max(0, sample.phase));
+        history.interval = (sample.interval > 0) ? sample.interval : PixelRPSystem11.DEFAULT_INTERVAL;
+        history.x = sample.x;
+        history.y = sample.y;
+        history.z = sample.z;
+
+        if(this._history.size > 128)
+        {
+            for(const [ id, item ] of this._history)
+            {
+                if((now - item.updatedAt) > 5000) this._history.delete(id);
+            }
+        }
+    }
+
+    public considerPair(ownId: number, remoteId: number, now: number): void
+    {
+        if(this._session || (ownId < 0) || (remoteId < 0) || (ownId === remoteId)) return;
+
+        const own = this._history.get(ownId);
+        const remote = this._history.get(remoteId);
+
+        if(!own || !remote || !own.moving || !remote.moving || !own.current || !remote.current) return;
+        if((Math.abs(own.x - remote.x) > 1.05) || (Math.abs(own.y - remote.y) > 1.05)) return;
+
+        const ownStartedFirst = ((own.walkSince >= 0) && (remote.walkSince >= 0) && (own.walkSince < remote.walkSince));
+        const remoteStartedFirst = ((own.walkSince >= 0) && (remote.walkSince >= 0) && (remote.walkSince < own.walkSince));
+        const master = ownStartedFirst ? own : (remoteStartedFirst ? remote : ((own.id < remote.id) ? own : remote));
+        const joiner = (master.id === own.id) ? remote : own;
+        const pairKey = this.pairKey(master.id, joiner.id);
+
+        if(this._reengagementBlock && (this._reengagementBlock.pairKey === pairKey))
+        {
+            const blockedJoiner = this._history.get(this._reengagementBlock.joinerId);
+
+            if(!blockedJoiner || (blockedJoiner.sequence <= this._reengagementBlock.joinerSequence)) return;
+
+            this._reengagementBlock = null;
+        }
+
+        let joinerSlotShift = NaN;
+        let wasPending = false;
+
+        if(this._pendingAdoption
+            && (this._pendingAdoption.pairKey === pairKey)
+            && (this._pendingAdoption.masterId === master.id)
+            && (this._pendingAdoption.joinerId === joiner.id))
+        {
+            wasPending = true;
+
+            if((this._pendingAdoption.masterSequenceSeen === master.sequence)
+                && (this._pendingAdoption.joinerSequenceSeen === joiner.sequence)) return;
+
+            joinerSlotShift = this._pendingAdoption.joinerSlotShift;
+        }
+
+        let timingDelta = NaN;
+
+        if(!Number.isFinite(joinerSlotShift))
+        {
+            const slotAssignment = this.assignSlotShift(master, joiner);
+
+            joinerSlotShift = slotAssignment.shift;
+            timingDelta = slotAssignment.timingDelta;
+        }
+
+        const proposal = Number.isFinite(joinerSlotShift)
+            ? this.proposeForSlot(master, joiner, joinerSlotShift, timingDelta)
+            : this.unknownProposal(master, timingDelta, 'slot-boundary-uncertain');
+        const target = this.targetForProposal(proposal, master.phase);
+        const targetJump = target ? this.tileDistance(joiner.x, joiner.y, joiner.z, target.x, target.y, target.z) : NaN;
+
+        if((proposal.relation === PixelRPSystem11Relation.DIVERGED))
+        {
+            this._pendingAdoption = null;
+
+            if(wasPending)
+            {
+                this.logTransition('S11_DIVERGE', 'NATIVE', PixelRPSystem11Relation.UNKNOWN, PixelRPSystem11Relation.DIVERGED,
+                    master, joiner, joinerSlotShift, targetJump, proposal.reason, proposal.joinerEdge);
+            }
+
+            return;
+        }
+
+        if((proposal.relation === PixelRPSystem11Relation.UNKNOWN)
+            || !target
+            || (targetJump > PixelRPSystem11.MAX_ADOPTION_DISCREPANCY))
+        {
+            this._pendingAdoption = {
+                pairKey,
+                masterId: master.id,
+                joinerId: joiner.id,
+                joinerSlotShift,
+                masterSequenceSeen: master.sequence,
+                joinerSequenceSeen: joiner.sequence
+            };
+
+            this.logTransition('S11_PENDING', 'PENDING', PixelRPSystem11Relation.UNKNOWN, proposal.relation,
+                master, joiner, joinerSlotShift, targetJump, proposal.reason, proposal.joinerEdge);
+            return;
+        }
+
+        this._pendingAdoption = null;
+        this._session = {
+            masterId: master.id,
+            joinerId: joiner.id,
+            pairKey,
+            joinerSlotShift,
+            relation: proposal.relation,
+            masterSequenceSeen: master.sequence,
+            joinerSequenceSeen: joiner.sequence,
+            renderMasterSlot: master.current.slot,
+            renderJoinerEdge: proposal.joinerEdge,
+            lastSharedPhase: master.phase,
+            lastPhaseAt: now,
+            lastRenderedX: target.x,
+            lastRenderedY: target.y,
+            lastRenderedZ: target.z,
+            lastRenderedAt: now,
+            stoppedSince: 0
+        };
+
+        this.logTransition('S11_ACTIVATE', 'SLOT', PixelRPSystem11Relation.UNKNOWN, proposal.relation,
+            master, joiner, joinerSlotShift, targetJump, proposal.reason, proposal.joinerEdge);
+    }
+
+    public getTarget(id: number, now: number): PixelRPSystem11Target
+    {
+        const session = this._session;
+
+        if(!session || (session.joinerId !== id)) return null;
+
+        const master = this._history.get(session.masterId);
+        const joiner = this._history.get(session.joinerId);
+
+        if(!master || !joiner)
+        {
+            this.release('history-missing');
+            return null;
+        }
+
+        if(!master.moving || !joiner.moving)
+        {
+            if(!session.stoppedSince) session.stoppedSince = now;
+
+            if((now - session.stoppedSince) > PixelRPSystem11.STOP_GRACE_MS)
+            {
+                this.release('movement-stopped');
+                return null;
+            }
+        }
+        else
+        {
+            session.stoppedSince = 0;
+        }
+
+        if(this.explicitlyDiverged(master, joiner))
+        {
+            const proposal = this.unknownProposal(master, NaN, 'native-route-diverged');
+            proposal.relation = PixelRPSystem11Relation.DIVERGED;
+            this.logTransition('S11_DIVERGE', 'NATIVE', session.relation, PixelRPSystem11Relation.DIVERGED,
+                master, joiner, session.joinerSlotShift, NaN, proposal.reason, null);
+            this.release('native-route-diverged');
+            return null;
+        }
+
+        const edgeEvent = ((master.sequence !== session.masterSequenceSeen) || (joiner.sequence !== session.joinerSequenceSeen));
+
+        if(edgeEvent)
+        {
+            session.masterSequenceSeen = master.sequence;
+            session.joinerSequenceSeen = joiner.sequence;
+
+            const proposal = this.proposeForSlot(master, joiner, session.joinerSlotShift, NaN);
+
+            if(proposal.relation === PixelRPSystem11Relation.DIVERGED)
+            {
+                this.logTransition('S11_DIVERGE', 'NATIVE', session.relation, PixelRPSystem11Relation.DIVERGED,
+                    master, joiner, session.joinerSlotShift, NaN, proposal.reason, proposal.joinerEdge);
+                this.release('route-slots-diverged');
+                return null;
+            }
+
+            if((proposal.relation !== PixelRPSystem11Relation.UNKNOWN) && proposal.joinerEdge)
+            {
+                const proposedTarget = this.targetForProposal(proposal, master.phase);
+                const targetJump = proposedTarget
+                    ? this.tileDistance(session.lastRenderedX, session.lastRenderedY, session.lastRenderedZ, proposedTarget.x, proposedTarget.y, proposedTarget.z)
+                    : NaN;
+                const elapsed = Math.min(100, Math.max(0, (now - session.lastRenderedAt)));
+                const interval = (master.interval > 0) ? master.interval : PixelRPSystem11.DEFAULT_INTERVAL;
+                const allowedJump = Math.min(0.27, (PixelRPSystem11.MAX_CONTINUITY_DISCREPANCY + (elapsed / interval)));
+
+                if(proposedTarget && (targetJump <= allowedJump))
+                {
+                    const oldRelation = session.relation;
+
+                    session.relation = proposal.relation;
+                    session.renderMasterSlot = master.current.slot;
+                    session.renderJoinerEdge = proposal.joinerEdge;
+                    session.lastSharedPhase = master.phase;
+                    session.lastPhaseAt = now;
+
+                    if(oldRelation !== proposal.relation)
+                    {
+                        this.logTransition('S11_RELATION_CHANGE', 'SLOT', oldRelation, proposal.relation,
+                            master, joiner, session.joinerSlotShift, targetJump, proposal.reason, proposal.joinerEdge);
+                    }
+                }
+                else
+                {
+                    this.logTransition('S11_REJECT', 'SLOT', session.relation, proposal.relation,
+                        master, joiner, session.joinerSlotShift, targetJump, 'target-discontinuous', proposal.joinerEdge);
+                }
+            }
+            else
+            {
+                this.logTransition('S11_PENDING', 'SLOT', session.relation, proposal.relation,
+                    master, joiner, session.joinerSlotShift, NaN, proposal.reason, proposal.joinerEdge);
+            }
+        }
+
+        if(!session.renderJoinerEdge || ((now - session.renderJoinerEdge.changedAt) > PixelRPSystem11.EDGE_STALE_MS))
+        {
+            this.release('render-edge-stale');
+            return null;
+        }
+
+        if((master.current.slot - session.renderMasterSlot) > 1)
+        {
+            this.release('joiner-slot-missing');
+            return null;
+        }
+
+        let phase = master.phase;
+
+        if(session.renderMasterSlot !== master.current.slot)
+        {
+            const interval = (master.interval > 0) ? master.interval : PixelRPSystem11.DEFAULT_INTERVAL;
+            phase = Math.min(1, (session.lastSharedPhase + ((now - session.lastPhaseAt) / interval)));
+        }
+
+        const target = this.pointOnEdge(session.renderJoinerEdge, phase);
+
+        if(!target)
+        {
+            this.release('render-target-missing');
+            return null;
+        }
+
+        const elapsed = Math.min(100, Math.max(1, (now - session.lastRenderedAt)));
+        const interval = (master.interval > 0) ? master.interval : PixelRPSystem11.DEFAULT_INTERVAL;
+        const proposedDelta = this.tileDistance(session.lastRenderedX, session.lastRenderedY, session.lastRenderedZ, target.x, target.y, target.z);
+        const maxSaneDelta = Math.min(0.27, (PixelRPSystem11.MAX_CONTINUITY_DISCREPANCY + (elapsed / interval)));
+
+        if(proposedDelta > maxSaneDelta)
+        {
+            const proposal: PixelRPSlotProposal = {
+                relation: session.relation,
+                masterEdge: master.current,
+                joinerEdge: session.renderJoinerEdge,
+                timingDelta: NaN,
+                reason: 'impossible-frame-displacement'
+            };
+
+            this.logTransition('S11_REJECT', 'SLOT', session.relation, session.relation,
+                master, joiner, session.joinerSlotShift, proposedDelta, proposal.reason, session.renderJoinerEdge);
+            this.release('impossible-frame-displacement');
+            return null;
+        }
+
+        session.lastSharedPhase = phase;
+        session.lastPhaseAt = now;
+        session.lastRenderedX = target.x;
+        session.lastRenderedY = target.y;
+        session.lastRenderedZ = target.z;
+        session.lastRenderedAt = now;
+
+        return target;
+    }
+
+    private assignSlotShift(master: PixelRPRouteHistory, joiner: PixelRPRouteHistory): { shift: number; timingDelta: number }
+    {
+        const interval = Math.max(1, ((master.interval + joiner.interval) / 2));
+        const timingDelta = ((joiner.current.startedAt - master.current.startedAt) / interval);
+        const nearestOffset = Math.round(timingDelta);
+        const distanceFromBoundary = Math.abs(Math.abs(timingDelta - Math.trunc(timingDelta)) - 0.5);
+
+        if((distanceFromBoundary <= PixelRPSystem11.SLOT_BOUNDARY_UNCERTAINTY)
+            || (Math.abs(nearestOffset) > PixelRPSystem11.MAX_SLOT_OFFSET))
+        {
+            return { shift: NaN, timingDelta };
+        }
+
+        return {
+            shift: (master.current.slot + nearestOffset - joiner.current.slot),
+            timingDelta
+        };
+    }
+
+    private proposeForSlot(master: PixelRPRouteHistory, joiner: PixelRPRouteHistory, joinerSlotShift: number, timingDelta: number): PixelRPSlotProposal
+    {
+        if(!master.current || !joiner.current || !Number.isFinite(joinerSlotShift))
+        {
+            return this.unknownProposal(master, timingDelta, 'slot-mapping-unavailable');
+        }
+
+        const requiredJoinerSlot = (master.current.slot - joinerSlotShift);
+        const joinerEdge = this.findEdge(joiner, requiredJoinerSlot);
+
+        if(!joinerEdge)
+        {
+            return this.unknownProposal(master, timingDelta, 'required-real-edge-missing');
+        }
+
+        if(this.edgeEquals(master.current, joinerEdge))
+        {
+            return { relation: PixelRPSystem11Relation.ALIGNED, masterEdge: master.current, joinerEdge, timingDelta, reason: 'same-route-slot' };
+        }
+
+        if((joinerEdge.gx === master.current.sx) && (joinerEdge.gy === master.current.sy))
+        {
+            return { relation: PixelRPSystem11Relation.BEHIND, masterEdge: master.current, joinerEdge, timingDelta, reason: 'previous-route-slot' };
+        }
+
+        if((master.current.gx === joinerEdge.sx) && (master.current.gy === joinerEdge.sy))
+        {
+            return { relation: PixelRPSystem11Relation.AHEAD, masterEdge: master.current, joinerEdge, timingDelta, reason: 'next-route-slot' };
+        }
+
+        if(this.edgesExplicitlyDiverged(master.current, joinerEdge))
+        {
+            return { relation: PixelRPSystem11Relation.DIVERGED, masterEdge: master.current, joinerEdge, timingDelta, reason: 'route-slots-diverged' };
+        }
+
+        return { relation: PixelRPSystem11Relation.UNKNOWN, masterEdge: master.current, joinerEdge, timingDelta, reason: 'route-slot-offset-unsupported' };
+    }
+
+    private unknownProposal(master: PixelRPRouteHistory, timingDelta: number, reason: string): PixelRPSlotProposal
+    {
+        return {
+            relation: PixelRPSystem11Relation.UNKNOWN,
+            masterEdge: master ? master.current : null,
+            joinerEdge: null,
+            timingDelta,
+            reason
+        };
+    }
+
+    private targetForProposal(proposal: PixelRPSlotProposal, phase: number): PixelRPSystem11Target
+    {
+        return proposal ? this.pointOnEdge(proposal.joinerEdge, phase) : null;
+    }
+
+    private pointOnEdge(edge: PixelRPRouteEdge, phase: number): PixelRPSystem11Target
+    {
+        if(!edge) return null;
+
+        return {
+            x: (edge.sx + ((edge.gx - edge.sx) * phase)),
+            y: (edge.sy + ((edge.gy - edge.sy) * phase)),
+            z: (edge.sz + ((edge.gz - edge.sz) * phase))
+        };
+    }
+
+    private findEdge(history: PixelRPRouteHistory, slot: number): PixelRPRouteEdge
+    {
+        for(let index = (history.edges.length - 1); index >= 0; index--)
+        {
+            const edge = history.edges[index];
+
+            if(edge.slot === slot) return edge;
+            if(edge.slot < slot) break;
+        }
+
+        return null;
+    }
+
+    private explicitlyDiverged(master: PixelRPRouteHistory, joiner: PixelRPRouteHistory): boolean
+    {
+        if(!master.current || !joiner.current) return false;
+        if(this.edgesExplicitlyDiverged(master.current, joiner.current)) return true;
+        if((Math.abs(master.x - joiner.x) > 1.5) || (Math.abs(master.y - joiner.y) > 1.5)) return true;
+
+        return false;
+    }
+
+    private edgesExplicitlyDiverged(master: PixelRPRouteEdge, joiner: PixelRPRouteEdge): boolean
+    {
+        if(!master || !joiner) return false;
+
+        const sameStart = ((master.sx === joiner.sx) && (master.sy === joiner.sy));
+        const differentGoal = ((master.gx !== joiner.gx) || (master.gy !== joiner.gy));
+
+        return (sameStart && differentGoal);
+    }
+
+    private release(reason: string): void
+    {
+        const session = this._session;
+
+        if(!session) return;
+
+        const master = this._history.get(session.masterId);
+        const joiner = this._history.get(session.joinerId);
+        const targetDistance = (joiner && Number.isFinite(session.lastRenderedX))
+            ? this.tileDistance(session.lastRenderedX, session.lastRenderedY, session.lastRenderedZ, joiner.x, joiner.y, joiner.z)
+            : NaN;
+
+        this._reengagementBlock = {
+            pairKey: session.pairKey,
+            joinerId: session.joinerId,
+            joinerSequence: joiner ? joiner.sequence : 0
+        };
+
+        this.logTransition('S11_DEACTIVATE', 'NATIVE', session.relation, PixelRPSystem11Relation.UNKNOWN,
+            master, joiner, session.joinerSlotShift, targetDistance, reason, session.renderJoinerEdge);
+
+        this._session = null;
+    }
+
+    private tileDistance(ax: number, ay: number, az: number, bx: number, by: number, bz: number): number
+    {
+        return Math.max(Math.abs(ax - bx), Math.abs(ay - by), Math.abs(az - bz));
+    }
+
+    private edgeEquals(a: PixelRPRouteEdge, b: PixelRPRouteEdge): boolean
+    {
+        return !!(a && b && (a.sx === b.sx) && (a.sy === b.sy) && (a.gx === b.gx) && (a.gy === b.gy));
+    }
+
+    private edgesContiguous(a: PixelRPRouteEdge, b: PixelRPRouteEdge): boolean
+    {
+        return !!(a && b && (a.gx === b.sx) && (a.gy === b.sy));
+    }
+
+    private pairKey(a: number, b: number): string
+    {
+        return (a < b) ? `${ a }:${ b }` : `${ b }:${ a }`;
+    }
+
+    private logTransition(event: string, timeSource: 'NATIVE' | 'PENDING' | 'SLOT', oldRelation: PixelRPSystem11Relation, newRelation: PixelRPSystem11Relation,
+        master: PixelRPRouteHistory, joiner: PixelRPRouteHistory, slotOffset: number, targetDistance: number, reason: string, joinerEdge: PixelRPRouteEdge): void
+    {
+        if(!PixelRPSystem11.INSTRUMENT_TRANSITIONS) return;
+
+        const masterSlot = (master && master.current) ? master.current.slot : NaN;
+        const joinerSlot = joinerEdge
+            ? joinerEdge.slot
+            : ((Number.isFinite(masterSlot) && Number.isFinite(slotOffset)) ? (masterSlot - slotOffset) : ((joiner && joiner.current) ? joiner.current.slot : NaN));
+        const masterPhase = master ? master.phase : NaN;
+        const joinerNativePhase = joiner ? joiner.phase : NaN;
+
+        console.log(`[${ event }] timeSource=${ timeSource } oldRelation=${ PixelRPSystem11Relation[oldRelation] } newRelation=${ PixelRPSystem11Relation[newRelation] } masterSlot=${ Number.isFinite(masterSlot) ? masterSlot : 'n/a' } joinerSlot=${ Number.isFinite(joinerSlot) ? joinerSlot : 'n/a' } slotOffset=${ Number.isFinite(slotOffset) ? slotOffset : 'n/a' } masterPhase=${ Number.isFinite(masterPhase) ? masterPhase.toFixed(3) : 'n/a' } joinerNativePhase=${ Number.isFinite(joinerNativePhase) ? joinerNativePhase.toFixed(3) : 'n/a' } targetDistance=${ Number.isFinite(targetDistance) ? targetDistance.toFixed(3) : 'n/a' } reason=${ reason }`);
+    }
+}
