+        this._chromeOpacity = 95;
+        this._headerColor = '';
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._chromeColor = wrapper.readString();
+        this._chromeOpacity = wrapper.readInt();
+        this._headerColor = wrapper.readString();
+
+        return true;
+    }
+
+    public get chromeColor(): string
+    {
+        return this._chromeColor;
+    }
+
+    public get chromeOpacity(): number
+    {
+        return this._chromeOpacity;
+    }
+
+    public get headerColor(): string
+    {
+        return this._headerColor;
+    }
+}
+
+export class RpUiSettingsEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpUiSettingsParser);
+    }
+
+    public getParser(): RpUiSettingsParser
+    {
+        return this.parser as RpUiSettingsParser;
+    }
+}
