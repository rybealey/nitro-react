+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the server's current airplane-mode state for this player. Drives
+// the phone's Settings toggle; while on, friend requests are hidden and DMs
+// to the player bounce with a "not delivered" receipt.
+export class RpAirplaneModeParser implements IMessageParser
+{
+    private _enabled: boolean;
+
+    public flush(): boolean
+    {
+        this._enabled = false;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._enabled = wrapper.readBoolean();
+
+        return true;
+    }
+
+    public get enabled(): boolean
+    {
+        return this._enabled;
+    }
+}
+
+export class RpAirplaneModeEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpAirplaneModeParser);
+    }
+
+    public getParser(): RpAirplaneModeParser
+    {
+        return this.parser as RpAirplaneModeParser;
+    }
+}
