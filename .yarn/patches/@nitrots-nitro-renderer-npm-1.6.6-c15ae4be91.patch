@@ -0,0 +1,68 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the VIP diamonds store catalog listing, pushed on request.
+export interface DiamondsStoreListing
+{
+    itemKey: string;
+    name: string;
+    description: string;
+    icon: string;
+    price: number;
+    specialPrice: number; // -1 = no sale; >= 0 overrides price
+    vipDays: number;
+}
+
+export class DiamondsStoreParser implements IMessageParser
+{
+    private _items: DiamondsStoreListing[];
+
+    public flush(): boolean
+    {
+        this._items = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._items = [];
+
+        const total = wrapper.readInt();
+
+        for(let i = 0; i < total; i++)
+        {
+            const itemKey = wrapper.readString();
+            const name = wrapper.readString();
+            const description = wrapper.readString();
+            const icon = wrapper.readString();
+            const price = wrapper.readInt();
+            const specialPrice = wrapper.readInt();
+            const vipDays = wrapper.readInt();
+
+            this._items.push({ itemKey, name, description, icon, price, specialPrice, vipDays });
+        }
+
+        return true;
+    }
+
+    public get items(): DiamondsStoreListing[]
+    {
+        return this._items;
+    }
+}
+
+export class DiamondsStoreEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, DiamondsStoreParser);
+    }
+
+    public getParser(): DiamondsStoreParser
+    {
+        return this.parser as DiamondsStoreParser;
+    }
+}
