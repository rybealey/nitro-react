+// PixelRP: save a UI setting server-side (chrome color scheme picked in the
+// Settings window's Interface tab). Empty string resets to default.
+export class RpSaveUiSettingsComposer implements IMessageComposer<ConstructorParameters<typeof RpSaveUiSettingsComposer>>
+{
+    private _data: ConstructorParameters<typeof RpSaveUiSettingsComposer>;
+
+    constructor(chromeColor: string, chromeOpacity: number, headerColor: string)
+    {
+        this._data = [chromeColor, chromeOpacity, headerColor];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
