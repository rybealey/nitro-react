diff --git a/src/nitro/communication/messages/incoming/RpUserCorpEvent.ts b/src/nitro/communication/messages/incoming/RpUserCorpEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9cae98f10ab6026b5ed36e7b27f0017262fdabaf
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpUserCorpEvent.ts
@@ -0,0 +1,84 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: one player's employment state, keyed by user id (corpId 0 =
+// unemployed). Sent on room entry for everyone present, on profile open,
+// and broadcast in real-time when someone is hired.
+export class RpUserCorpParser implements IMessageParser
+{
+    private _userId: number;
+    private _corpId: number;
+    private _badge: string;
+    private _corpName: string;
+    private _rankName: string;
+    private _tier: number;
+
+    public flush(): boolean
+    {
+        this._userId = 0;
+        this._corpId = 0;
+        this._badge = '';
+        this._corpName = '';
+        this._rankName = '';
+        this._tier = 0;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._userId = wrapper.readInt();
+        this._corpId = wrapper.readInt();
+        this._badge = wrapper.readString();
+        this._corpName = wrapper.readString();
+        this._rankName = wrapper.readString();
+        this._tier = wrapper.readInt();
+
+        return true;
+    }
+
+    public get userId(): number
+    {
+        return this._userId;
+    }
+
+    public get corpId(): number
+    {
+        return this._corpId;
+    }
+
+    public get badge(): string
+    {
+        return this._badge;
+    }
+
+    public get corpName(): string
+    {
+        return this._corpName;
+    }
+
+    public get rankName(): string
+    {
+        return this._rankName;
+    }
+
+    public get tier(): number
+    {
+        return this._tier;
+    }
+}
+
+export class RpUserCorpEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpUserCorpParser);
+    }
+
+    public getParser(): RpUserCorpParser
+    {
+        return this.parser as RpUserCorpParser;
+    }
+}
