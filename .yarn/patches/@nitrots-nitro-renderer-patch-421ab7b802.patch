@@ -0,0 +1,22 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: request one player's employment state (profile opened).
+export class RpGetUserCorpComposer implements IMessageComposer<ConstructorParameters<typeof RpGetUserCorpComposer>>
+{
+    private _data: ConstructorParameters<typeof RpGetUserCorpComposer>;
+
+    constructor(userId: number)
+    {
+        this._data = [userId];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
