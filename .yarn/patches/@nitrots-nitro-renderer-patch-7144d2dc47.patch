-    /**
-     * Resolve the single real recorded edge JOINER must render for MASTER's
-     * current slot and the fixed logical offset. BEHIND/ALIGNED edges can fall
-     * back to MASTER's own recorded history (same proven route, and always
-     * available the instant MASTER rolls over); AHEAD only ever comes from
-     * JOINER's queue. Contiguity with MASTER's current edge is required so the
-     * one-step relationship stays route-correct around corners — edges are
-     * never synthesized.
-     */
-    private resolveRenderEdge(master: PixelRPRouteHistory, joiner: PixelRPRouteHistory, pairBaseline: number, logicalOffset: number): PixelRPRenderEdgeResolution
-    {
-        if(!master.current || !Number.isFinite(pairBaseline) || !Number.isFinite(logicalOffset)
