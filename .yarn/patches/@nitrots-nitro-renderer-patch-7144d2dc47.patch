-                return { status: 'diverged', edge: null, reason: 'aligned-edge-mismatch' };
-            }
-
-            return { status: 'ok', edge: master.current, reason: 'master-current-edge' };
-        }
-
-        if(logicalOffset === 1)
-        {
-            const masterEdge = this.findEdge(master, (master.current.slot - 1));
-
-            if(joinerEdge && masterEdge && !this.edgeEquals(joinerEdge, masterEdge))
-            {
-                return { status: 'diverged', edge: null, reason: 'behind-edge-mismatch' };
-            }
