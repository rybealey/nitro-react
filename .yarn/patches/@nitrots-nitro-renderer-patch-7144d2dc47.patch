-            const edge = (joinerEdge || masterEdge);
-
-            if(!edge) return { status: 'missing', edge: null, reason: 'behind-edge-missing' };
-
-            if(!this.edgesContiguous(edge, master.current))
-            {
-                return { status: 'diverged', edge: null, reason: 'behind-edge-not-contiguous' };
-            }
