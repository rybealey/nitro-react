--- /dev/null
+++ b/src/nitro/communication/messages/outgoing/RpSetAirplaneModeComposer.ts
@@ -0,0 +1,22 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: toggle the player's airplane mode (persisted server-side).
+export class RpSetAirplaneModeComposer implements IMessageComposer<ConstructorParameters<typeof RpSetAirplaneModeComposer>>
+{
+    private _data: ConstructorParameters<typeof RpSetAirplaneModeComposer>;
+
+    constructor(enabled: boolean)
+    {
+        this._data = [enabled];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
