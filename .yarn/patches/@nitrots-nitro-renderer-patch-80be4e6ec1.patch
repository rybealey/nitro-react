diff --git a/src/nitro/communication/messages/outgoing/RpSetEmergencyComposer.ts b/src/nitro/communication/messages/outgoing/RpSetEmergencyComposer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..caab1c14707bc07c5ff4fb2c959cd991a87caaa3
--- /dev/null
+++ b/src/nitro/communication/messages/outgoing/RpSetEmergencyComposer.ts
@@ -0,0 +1,24 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: toggles a room-level emergency service flag (medical/police/
+// staff category, authorized ranks only, enforced server-side). The flag
+// travels as int 0/1 - the emulator reads ReadInt() == 1.
+export class RpSetEmergencyComposer implements IMessageComposer<[ number, number ]>
+{
+    private _data: [ number, number ];
+
+    constructor(category: number, enabled: boolean)
+    {
+        this._data = [ category, enabled ? 1 : 0 ];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
