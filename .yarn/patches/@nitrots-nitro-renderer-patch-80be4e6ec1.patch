diff --git a/src/nitro/communication/messages/incoming/RpRoomCorpEvent.ts b/src/nitro/communication/messages/incoming/RpRoomCorpEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a36ec954602ef0ace6733f5ddb84b2d491799f83
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpRoomCorpEvent.ts
@@ -0,0 +1,84 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: room-level corp HQ context - the rank ladder for the current
+// owning corp (id, order, name, authorized-to-set-emergency flag) plus the
+// room's emergency service flags. Sent when the settings window opens and
+// echoed back after a save.
+export interface RpRoomCorpRank
+{
+    rankId: number;
+    rankOrder: number;
+    rankName: string;
+    authorized: boolean;
+}
+
+export class RpRoomCorpParser implements IMessageParser
+{
+    private _roomId: number;
+    private _corpId: number;
+    private _ranks: RpRoomCorpRank[];
+    private _allowMedical: boolean;
+    private _allowPolice: boolean;
+    private _allowStaff: boolean;
+
+    public flush(): boolean
+    {
+        this._roomId = 0;
+        this._corpId = 0;
+        this._ranks = [];
+        this._allowMedical = false;
+        this._allowPolice = false;
+        this._allowStaff = false;
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._roomId = wrapper.readInt();
+        this._corpId = wrapper.readInt();
+        this._ranks = [];
+
+        let rankCount = wrapper.readInt();
+
+        while(rankCount > 0)
+        {
+            const rankId = wrapper.readInt();
+            const rankOrder = wrapper.readInt();
+            const rankName = wrapper.readString();
+            const authorized = (wrapper.readInt() === 1);
+
+            this._ranks.push({ rankId, rankOrder, rankName, authorized });
+
+            rankCount--;
+        }
+
+        this._allowMedical = (wrapper.readInt() === 1);
+        this._allowPolice = (wrapper.readInt() === 1);
+        this._allowStaff = (wrapper.readInt() === 1);
+
+        return true;
+    }
+
+    public get roomId(): number { return this._roomId; }
+    public get corpId(): number { return this._corpId; }
+    public get ranks(): RpRoomCorpRank[] { return this._ranks; }
+    public get allowMedical(): boolean { return this._allowMedical; }
+    public get allowPolice(): boolean { return this._allowPolice; }
+    public get allowStaff(): boolean { return this._allowStaff; }
+}
+
+export class RpRoomCorpEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpRoomCorpParser);
+    }
+
+    public getParser(): RpRoomCorpParser
+    {
+        return this.parser as RpRoomCorpParser;
+    }
+}
