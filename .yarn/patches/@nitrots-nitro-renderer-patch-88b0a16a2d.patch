     // layer into this engine-level class.
     private static UNIT_TYPE_KEYS: string[] = [ 'user', 'pet', 'bot', 'rentable_bot', 'monsterplant' ];
 
-    // PixelRP master/joiner persistent formation state (sync.formationState).
-    // Replaces a one-shot ENGAGE-time boolean with evidence-driven
-    // classification — see the _pixelrpSync field comment and the
-    // evidence-accumulation block in renderObject() for the full model.
-    // CANDIDATE: freshly engaged, insufficient route-relation evidence yet
