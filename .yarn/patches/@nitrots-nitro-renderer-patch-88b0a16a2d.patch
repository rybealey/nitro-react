index 0000000000000000000000000000000000000000..5585840aaad83a2120256ce864f62c772fadf88a
--- /dev/null
+++ b/src/room/renderer/PixelRPSystem11.ts
@@ -0,0 +1,537 @@
+export enum PixelRPSystem11Relation
+{
+    UNKNOWN = 0,
+    ALIGNED = 1,
+    BEHIND = 2,
+    AHEAD = 3,
+    DIVERGED = 4
+}
+
+export interface PixelRPMovementSample
+{
+    id: number;
+    moving: boolean;
+    sx: number;
+    sy: number;
+    sz: number;
+    gx: number;
+    gy: number;
+    gz: number;
+    phase: number;
+    x: number;
+    y: number;
+    z: number;
+}
+
+export interface PixelRPSystem11Target
+{
+    x: number;
+    y: number;
+    z: number;
+}
+
+interface PixelRPRouteEdge
+{
+    sx: number;
+    sy: number;
+    sz: number;
+    gx: number;
+    gy: number;
+    gz: number;
+    changedAt: number;
+}
+
+interface PixelRPRouteHistory
+{
+    id: number;
+    updatedAt: number;
+    moving: boolean;
+    phase: number;
+    x: number;
+    y: number;
+    z: number;
+    walkSince: number;
+    sequence: number;
+    current: PixelRPRouteEdge;
+    previous: PixelRPRouteEdge;
+}
+
+interface PixelRPSystem11Session
+{
+    masterId: number;
+    joinerId: number;
+    pairKey: string;
+    relation: PixelRPSystem11Relation;
+    lastProvenRelation: PixelRPSystem11Relation;
+    masterSequenceSeen: number;
+    joinerSequenceSeen: number;
+    masterAdvancedPending: boolean;
+    joinerAdvancedPending: boolean;
+    uncertaintySince: number;
+    renderEdge: PixelRPRouteEdge;
+    enteredAt: number;
+    entryOffsetSet: boolean;
+    entryOffsetX: number;
+    entryOffsetY: number;
+    entryOffsetZ: number;
+    lastRenderedX: number;
+    lastRenderedY: number;
+    lastRenderedZ: number;
+    lastRenderedAt: number;
+    stoppedSince: number;
+}
+
+interface PixelRPExitHandoff
+{
+    startedAt: number;
+    offsetX: number;
+    offsetY: number;
+    offsetZ: number;
+}
+
+interface PixelRPReengagementBlock
+{
+    pairKey: string;
+    joinerId: number;
+    joinerSequence: number;
+    startedAt: number;
+}
+
+/**
+ * PixelRP System 11 is deliberately a route-index renderer, not a correction
+ * engine. It records real edges before pairing, proves only offsets 0/-1/+1,
+ * uses MASTER's native phase, and returns native control immediately when the
+ * route is no longer compatible.
+ */
+export class PixelRPSystem11
+{
+    private static readonly EDGE_STALE_MS = 900;
+    private static readonly UNCERTAINTY_BACKSTOP_MS = 560;
+    private static readonly STOP_GRACE_MS = 160;
+    private static readonly HANDOFF_MS = 100;
+    private static readonly REENGAGE_BACKSTOP_MS = 1500;
+    private static readonly DEBUG = false;
+
+    private readonly _history = new Map<number, PixelRPRouteHistory>();
+    private readonly _exitHandoffs = new Map<number, PixelRPExitHandoff>();
+    private _session: PixelRPSystem11Session = null;
+    private _reengagementBlock: PixelRPReengagementBlock = null;
+
+    public record(sample: PixelRPMovementSample, now: number): void
+    {
+        let history = this._history.get(sample.id);
+
+        if(!history)
+        {
+            history = {
+                id: sample.id,
+                updatedAt: now,
+                moving: sample.moving,
+                phase: sample.phase,
+                x: sample.x,
+                y: sample.y,
+                z: sample.z,
+                walkSince: sample.moving ? now : -1,
+                sequence: 0,
+                current: null,
+                previous: null
+            };
+
+            this._history.set(sample.id, history);
+        }
+
+        if(sample.moving)
+        {
+            const nextEdge: PixelRPRouteEdge = {
+                sx: Math.round(sample.sx),
+                sy: Math.round(sample.sy),
+                sz: sample.sz,
+                gx: Math.round(sample.gx),
+                gy: Math.round(sample.gy),
+                gz: sample.gz,
+                changedAt: now
+            };
+
+            if(!history.current)
+            {
+                history.current = nextEdge;
+                history.sequence++;
+            }
+            else if(!this.edgeEquals(history.current, nextEdge))
+            {
+                history.previous = this.edgesContiguous(history.current, nextEdge) ? history.current : null;
+                history.current = nextEdge;
+                history.sequence++;
+            }
+
+            if(history.walkSince < 0) history.walkSince = now;
+        }
+        else
+        {
+            history.walkSince = -1;
+        }
+
+        history.updatedAt = now;
+        history.moving = sample.moving;
+        history.phase = Math.min(1, Math.max(0, sample.phase));
+        history.x = sample.x;
+        history.y = sample.y;
+        history.z = sample.z;
+
+        if(this._history.size > 128)
+        {
+            for(const [ id, item ] of this._history)
+            {
+                if((now - item.updatedAt) > 5000) this._history.delete(id);
+            }
+        }
+    }
+
+    public considerPair(ownId: number, remoteId: number, now: number): void
+    {
+        if(this._session || (ownId < 0) || (remoteId < 0) || (ownId === remoteId)) return;
+
+        const own = this._history.get(ownId);
+        const remote = this._history.get(remoteId);
+
+        if(!own || !remote || !own.moving || !remote.moving || !own.current || !remote.current) return;
+        if((Math.abs(own.x - remote.x) > 1.05) || (Math.abs(own.y - remote.y) > 1.05)) return;
+
+        const ownStartedFirst = ((own.walkSince >= 0) && (remote.walkSince >= 0) && (own.walkSince < remote.walkSince));
+        const remoteStartedFirst = ((own.walkSince >= 0) && (remote.walkSince >= 0) && (remote.walkSince < own.walkSince));
+        const master = ownStartedFirst ? own : (remoteStartedFirst ? remote : ((own.id < remote.id) ? own : remote));
+        const joiner = (master.id === own.id) ? remote : own;
+        const pairKey = this.pairKey(master.id, joiner.id);
+
+        if(this._reengagementBlock && (this._reengagementBlock.pairKey === pairKey))
+        {
+            const blockedJoiner = this._history.get(this._reengagementBlock.joinerId);
+            const completedIndependentEdge = !!(blockedJoiner && (blockedJoiner.sequence > this._reengagementBlock.joinerSequence));
+
+            if(!completedIndependentEdge && ((now - this._reengagementBlock.startedAt) < PixelRPSystem11.REENGAGE_BACKSTOP_MS)) return;
+
+            this._reengagementBlock = null;
+        }
+
+        const relation = this.classify(master, joiner);
+
+        if((relation === PixelRPSystem11Relation.UNKNOWN) || (relation === PixelRPSystem11Relation.DIVERGED)) return;
+
+        const renderEdge = this.edgeForRelation(relation, master, joiner);
+
+        if(!renderEdge) return;
+
+        this._session = {
+            masterId: master.id,
+            joinerId: joiner.id,
+            pairKey,
+            relation,
+            lastProvenRelation: relation,
+            masterSequenceSeen: master.sequence,
+            joinerSequenceSeen: joiner.sequence,
+            masterAdvancedPending: false,
+            joinerAdvancedPending: false,
+            uncertaintySince: 0,
+            renderEdge,
+            enteredAt: now,
+            entryOffsetSet: false,
+            entryOffsetX: 0,
+            entryOffsetY: 0,
+            entryOffsetZ: 0,
+            lastRenderedX: NaN,
+            lastRenderedY: NaN,
+            lastRenderedZ: NaN,
+            lastRenderedAt: now,
+            stoppedSince: 0
+        };
+
+        this.debug(`ENGAGE relation=${ PixelRPSystem11Relation[relation] } master=${ master.id } joiner=${ joiner.id }`);
+    }
+
+    public getTarget(id: number, now: number): PixelRPSystem11Target
+    {
+        const history = this._history.get(id);
+
+        if(!history) return null;
+
+        const session = this._session;
+
+        if(!session || (session.joinerId !== id)) return this.exitHandoffTarget(history, id, now);
+
+        const master = this._history.get(session.masterId);
+        const joiner = this._history.get(session.joinerId);
+
+        if(!master || !joiner)
+        {
+            this.release(now);
+            return this.exitHandoffTarget(history, id, now);
+        }
+
+        if(!master.moving || !joiner.moving)
+        {
+            if(!session.stoppedSince) session.stoppedSince = now;
+
+            if((now - session.stoppedSince) > PixelRPSystem11.STOP_GRACE_MS)
+            {
+                this.release(now);
+                return this.exitHandoffTarget(history, id, now);
+            }
+        }
+        else
+        {
+            session.stoppedSince = 0;
+        }
+
+        if(this.explicitlyDiverged(master, joiner))
+        {
+            this.release(now);
+            return this.exitHandoffTarget(history, id, now);
+        }
+
+        if(master.sequence !== session.masterSequenceSeen)
+        {
+            session.masterSequenceSeen = master.sequence;
+            session.masterAdvancedPending = true;
+            if(!session.uncertaintySince) session.uncertaintySince = now;
+        }
+
+        if(joiner.sequence !== session.joinerSequenceSeen)
+        {
+            session.joinerSequenceSeen = joiner.sequence;
+            session.joinerAdvancedPending = true;
+            if(!session.uncertaintySince) session.uncertaintySince = now;
+        }
+
+        if(session.masterAdvancedPending && session.joinerAdvancedPending)
+        {
+            if(!this.proveCurrentRelation(session, master, joiner, now))
+            {
+                this.release(now);
+                return this.exitHandoffTarget(history, id, now);
+            }
+        }
+        else if((session.masterAdvancedPending || session.joinerAdvancedPending)
+            && session.uncertaintySince && ((now - session.uncertaintySince) >= PixelRPSystem11.UNCERTAINTY_BACKSTOP_MS))
+        {
+            const observed = this.classify(master, joiner);
+
+            if((observed === PixelRPSystem11Relation.UNKNOWN) || (observed === PixelRPSystem11Relation.DIVERGED))
+            {
+                this.release(now);
+                return this.exitHandoffTarget(history, id, now);
+            }
+
+            this.commitRelation(session, observed, master, joiner);
+        }
+
+        // During ordinary one-sided rollover, preserve the proven relation.
+        // ALIGNED and BEHIND can select a new real MASTER edge continuously.
+        // AHEAD cannot predict MASTER's next turn, so a MASTER-first rollover
+        // briefly holds the last displayed endpoint until JOINER's real edge
+        // arrives.
+        if(session.masterAdvancedPending && !session.joinerAdvancedPending)
+        {
+            if(session.lastProvenRelation === PixelRPSystem11Relation.ALIGNED)
+            {
+                session.renderEdge = master.current;
+            }
+            else if((session.lastProvenRelation === PixelRPSystem11Relation.BEHIND) && master.previous)
+            {
+                session.renderEdge = master.previous;
+            }
+            else if((session.lastProvenRelation === PixelRPSystem11Relation.AHEAD) && Number.isFinite(session.lastRenderedX))
+            {
+                return { x: session.lastRenderedX, y: session.lastRenderedY, z: session.lastRenderedZ };
+            }
+        }
+
+        const edge = session.renderEdge;
+
+        if(!edge || ((now - edge.changedAt) > PixelRPSystem11.EDGE_STALE_MS))
+        {
+            this.release(now);
+            return this.exitHandoffTarget(history, id, now);
+        }
+
+        const phase = master.phase;
+        let x = (edge.sx + ((edge.gx - edge.sx) * phase));
+        let y = (edge.sy + ((edge.gy - edge.sy) * phase));
+        let z = (edge.sz + ((edge.gz - edge.sz) * phase));
+
+        if(!session.entryOffsetSet)
+        {
+            session.entryOffsetSet = true;
+            session.entryOffsetX = (joiner.x - x);
+            session.entryOffsetY = (joiner.y - y);
+            session.entryOffsetZ = (joiner.z - z);
+        }
+
+        const entryWeight = Math.max(0, (1 - ((now - session.enteredAt) / PixelRPSystem11.HANDOFF_MS)));
+
+        x += (session.entryOffsetX * entryWeight);
+        y += (session.entryOffsetY * entryWeight);
+        z += (session.entryOffsetZ * entryWeight);
+
+        if(Number.isFinite(session.lastRenderedX))
+        {
+            const elapsed = Math.min(100, Math.max(1, (now - session.lastRenderedAt)));
+            const proposedDelta = Math.hypot((x - session.lastRenderedX), (y - session.lastRenderedY));
+            const maxSaneDelta = Math.min(0.5, Math.max(0.08, (10 * (elapsed / 530))));
+
+            if(proposedDelta > maxSaneDelta)
+            {
+                this.release(now);
+                return this.exitHandoffTarget(history, id, now);
+            }
+        }
+
+        session.lastRenderedX = x;
+        session.lastRenderedY = y;
+        session.lastRenderedZ = z;
+        session.lastRenderedAt = now;
+
+        return { x, y, z };
+    }
+
+    private proveCurrentRelation(session: PixelRPSystem11Session, master: PixelRPRouteHistory, joiner: PixelRPRouteHistory, now: number): boolean
+    {
+        const observed = this.classify(master, joiner);
+
+        if((observed === PixelRPSystem11Relation.UNKNOWN) || (observed === PixelRPSystem11Relation.DIVERGED)) return false;
+
+        this.commitRelation(session, observed, master, joiner);
+        session.masterAdvancedPending = false;
+        session.joinerAdvancedPending = false;
+        session.uncertaintySince = 0;
+        session.lastRenderedAt = now;
+
+        return true;
+    }
+
+    private commitRelation(session: PixelRPSystem11Session, relation: PixelRPSystem11Relation, master: PixelRPRouteHistory, joiner: PixelRPRouteHistory): void
+    {
+        const edge = this.edgeForRelation(relation, master, joiner);
+
+        if(!edge) return;
+
+        session.relation = relation;
+        session.lastProvenRelation = relation;
+        session.renderEdge = edge;
+        session.masterAdvancedPending = false;
+        session.joinerAdvancedPending = false;
+        session.uncertaintySince = 0;
+
+        this.debug(`RELATION ${ PixelRPSystem11Relation[relation] } master=${ master.id } joiner=${ joiner.id }`);
+    }
+
+    private classify(master: PixelRPRouteHistory, joiner: PixelRPRouteHistory): PixelRPSystem11Relation
+    {
+        if(!master.current || !joiner.current) return PixelRPSystem11Relation.UNKNOWN;
+        if(this.edgeEquals(master.current, joiner.current)) return PixelRPSystem11Relation.ALIGNED;
+        if(master.previous && this.edgeEquals(joiner.current, master.previous)) return PixelRPSystem11Relation.BEHIND;
+        if(joiner.previous && this.edgeEquals(master.current, joiner.previous)) return PixelRPSystem11Relation.AHEAD;
+        if((joiner.current.gx === master.current.sx) && (joiner.current.gy === master.current.sy)) return PixelRPSystem11Relation.BEHIND;
+        if((master.current.gx === joiner.current.sx) && (master.current.gy === joiner.current.sy)) return PixelRPSystem11Relation.AHEAD;
+        if(this.explicitlyDiverged(master, joiner)) return PixelRPSystem11Relation.DIVERGED;
+
+        return PixelRPSystem11Relation.UNKNOWN;
+    }
+
+    private edgeForRelation(relation: PixelRPSystem11Relation, master: PixelRPRouteHistory, joiner: PixelRPRouteHistory): PixelRPRouteEdge
+    {
+        if(relation === PixelRPSystem11Relation.ALIGNED) return master.current;
+
+        if(relation === PixelRPSystem11Relation.BEHIND)
+        {
+            if(master.previous && this.edgeEquals(joiner.current, master.previous)) return master.previous;
+            if(joiner.current && (joiner.current.gx === master.current.sx) && (joiner.current.gy === master.current.sy)) return joiner.current;
+        }
+
+        if(relation === PixelRPSystem11Relation.AHEAD) return joiner.current;
+
+        return null;
+    }
+
+    private explicitlyDiverged(master: PixelRPRouteHistory, joiner: PixelRPRouteHistory): boolean
+    {
+        if(!master.current || !joiner.current) return false;
+
+        const sameStart = ((master.current.sx === joiner.current.sx) && (master.current.sy === joiner.current.sy));
+        const differentGoal = ((master.current.gx !== joiner.current.gx) || (master.current.gy !== joiner.current.gy));
+
+        if(sameStart && differentGoal) return true;
+        if((Math.abs(master.x - joiner.x) > 1.5) || (Math.abs(master.y - joiner.y) > 1.5)) return true;
+
+        return false;
+    }
+
+    private release(now: number): void
+    {
+        const session = this._session;
+
+        if(!session) return;
+
+        const joiner = this._history.get(session.joinerId);
+
+        if(joiner && Number.isFinite(session.lastRenderedX))
+        {
+            this._exitHandoffs.set(session.joinerId, {
+                startedAt: now,
+                offsetX: (session.lastRenderedX - joiner.x),
+                offsetY: (session.lastRenderedY - joiner.y),
+                offsetZ: (session.lastRenderedZ - joiner.z)
+            });
+        }
+
+        this._reengagementBlock = {
+            pairKey: session.pairKey,
+            joinerId: session.joinerId,
+            joinerSequence: joiner ? joiner.sequence : 0,
+            startedAt: now
+        };
+
+        this.debug(`RELEASE master=${ session.masterId } joiner=${ session.joinerId }`);
+        this._session = null;
+    }
+
+    private exitHandoffTarget(history: PixelRPRouteHistory, id: number, now: number): PixelRPSystem11Target
+    {
+        const handoff = this._exitHandoffs.get(id);
+
+        if(!handoff) return null;
+
+        const weight = Math.max(0, (1 - ((now - handoff.startedAt) / PixelRPSystem11.HANDOFF_MS)));
+
+        if(weight <= 0)
+        {
+            this._exitHandoffs.delete(id);
+            return null;
+        }
+
+        return {
+            x: (history.x + (handoff.offsetX * weight)),
+            y: (history.y + (handoff.offsetY * weight)),
+            z: (history.z + (handoff.offsetZ * weight))
+        };
+    }
+
+    private edgeEquals(a: PixelRPRouteEdge, b: PixelRPRouteEdge): boolean
+    {
+        return !!(a && b && (a.sx === b.sx) && (a.sy === b.sy) && (a.gx === b.gx) && (a.gy === b.gy));
+    }
+
+    private edgesContiguous(a: PixelRPRouteEdge, b: PixelRPRouteEdge): boolean
+    {
+        return !!(a && b && (a.gx === b.sx) && (a.gy === b.sy));
+    }
+
+    private pairKey(a: number, b: number): string
+    {
+        return (a < b) ? `${ a }:${ b }` : `${ b }:${ a }`;
+    }
+
+    private debug(message: string): void
+    {
+        if(PixelRPSystem11.DEBUG) console.log(`[system11] ${ message }`);
+    }
+}
