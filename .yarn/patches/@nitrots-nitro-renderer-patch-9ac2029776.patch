index 0000000000000000000000000000000000000000..2fff0df2c22dc4a009c07e022cd69c8ddf750f50
--- /dev/null
+++ b/src/nitro/communication/messages/outgoing/RpMessengerTypingComposer.ts
@@ -0,0 +1,23 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: the player is (or stopped) typing a message to a friend in the
+// phone's Messages app — the server relays the typing state to that friend.
+export class RpMessengerTypingComposer implements IMessageComposer<ConstructorParameters<typeof RpMessengerTypingComposer>>
+{
+    private _data: ConstructorParameters<typeof RpMessengerTypingComposer>;
+
+    constructor(friendId: number, typing: boolean)
+    {
+        this._data = [friendId, typing];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
