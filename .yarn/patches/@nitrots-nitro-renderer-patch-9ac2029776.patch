diff --git a/src/nitro/communication/messages/incoming/RpMessengerFriendTypingEvent.ts b/src/nitro/communication/messages/incoming/RpMessengerFriendTypingEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f6940756efbea3dfc318e99decb5abe96718c09
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpMessengerFriendTypingEvent.ts
@@ -0,0 +1,52 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: a friend is (or has stopped) typing a message to you in the
+// phone's Messages app. Live-only; the client also times the indicator out
+// on its own if a stop never arrives.
+export class RpMessengerFriendTypingParser implements IMessageParser
+{
+    private _friendId: number;
+    private _typing: boolean;
+
+    public flush(): boolean
+    {
+        this._friendId = 0;
+        this._typing = false;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._friendId = wrapper.readInt();
+        this._typing = wrapper.readBoolean();
+
+        return true;
+    }
+
+    public get friendId(): number
+    {
+        return this._friendId;
+    }
+
+    public get typing(): boolean
+    {
+        return this._typing;
+    }
+}
+
+export class RpMessengerFriendTypingEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpMessengerFriendTypingParser);
+    }
+
+    public getParser(): RpMessengerFriendTypingParser
+    {
+        return this.parser as RpMessengerFriendTypingParser;
+    }
+}
