diff --git a/src/room/renderer/utils/UploadGate.ts b/src/room/renderer/utils/UploadGate.ts
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/src/room/renderer/utils/UploadGate.ts
@@ -0,0 +1,82 @@
+import { BaseTexture, ImageResource, Renderer } from '@pixi/core';
+
+// PixelRP: pictures go to the graphics card a share per frame (Twist,
+// 2026-10-27).
+//
+// Pixi sends a sheet to the graphics card the first time something drawn uses
+// it. Walking into a room full of furni, or a crowd arriving, put hundreds of
+// new sheets into ONE frame - 387 sheets, 5.5 megapixels, a 310 ms draw on a
+// laptop in the crowd test - and on Chrome the card can take that in after
+// the page has finished, so the frame shows late with the page idle. Now a
+// frame drawn to the screen takes in FRAME_UPLOADS new sheets and FRAME_PIXELS
+// pixels at most (always one); a room sprite whose sheet has not had its turn
+// is left out of that frame (ExtendedSprite) and drawn a frame or so later, as
+// the room already fills in when it loads. Only sheets from images: a picture
+// drawn by the game itself (the floor and walls, avatars, render textures) is
+// never held back, and neither is anything drawn into a texture rather than to
+// the screen - avatar pictures, room previews, camera photos.
+const FRAME_UPLOADS = 12;
+const FRAME_PIXELS = 1000000;
+
+interface GateState
+{
+    admitted: Set<BaseTexture>;
+    uploads: number;
+    pixels: number;
+}
+
+const states: WeakMap<Renderer, GateState> = new WeakMap();
+
+const stateOf = (renderer: Renderer): GateState =>
+{
+    let state = states.get(renderer);
+
+    if(state) return state;
+
+    state = { admitted: new Set(), uploads: 0, pixels: 0 };
+
+    states.set(renderer, state);
+
+    // A new share for each draw to the screen, once a frame. Pictures drawn
+    // into textures in between run the same runner, and do not reset it.
+    renderer.runners.prerender.add({
+        prerender: () =>
+        {
+            if(!renderer.renderingToScreen) return;
+
+            state.admitted.clear();
+            state.uploads = 0;
+            state.pixels = 0;
+        }
+    });
+
+    return state;
+}
+
+// Whether a sprite on this sheet may be drawn this frame.
+export const MayDraw = (renderer: Renderer, baseTexture: BaseTexture): boolean =>
+{
+    if(!renderer || !baseTexture || !renderer.renderingToScreen || !baseTexture.valid) return true;
+
+    if(!(baseTexture.resource instanceof ImageResource)) return true;
+
+    //@ts-ignore - private in the typings
+    const glTexture = baseTexture._glTextures?.[renderer.CONTEXT_UID];
+
+    // already on the card, and up to date
+    if(glTexture && (glTexture.dirtyId === baseTexture.dirtyId)) return true;
+
+    const state = stateOf(renderer);
+
+    if(state.admitted.has(baseTexture)) return true;
+
+    const pixels = ((baseTexture.realWidth || 0) * (baseTexture.realHeight || 0));
+
+    if(state.uploads && (((state.uploads + 1) > FRAME_UPLOADS) || ((state.pixels + pixels) > FRAME_PIXELS))) return false;
+
+    state.admitted.add(baseTexture);
+    state.uploads++;
+    state.pixels += pixels;
+
+    return true;
+}
