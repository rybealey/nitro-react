diff --git a/src/api/utils/UnpackQueue.ts b/src/api/utils/UnpackQueue.ts
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/src/api/utils/UnpackQueue.ts
@@ -0,0 +1,68 @@
+// PixelRP: downloaded files are unpacked a few at a time (Twist, 2026-10-27).
+//
+// A crowd in new clothes, or a room of furni nobody had loaded yet, finishes
+// downloading together, and every file's unpacking - inflating it, reading its
+// JSON, making its picture and its asset collection - then ran back to back
+// in one task: 142 ms on a laptop in the crowd test, the screen held for all
+// of it. Now each piece of work waits its turn here, and one turn does
+// TURN_MS of them at most (always one), the rest in the turns after. Each
+// caller still gets exactly its own result, in the order it asked; only when
+// the work runs changes.
+//
+// The next turn is a scheduler task where the browser has them (Chrome), else
+// a timer. Measured in Chrome: chained message-channel tasks drew 1 frame in
+// 91 ms of this work, scheduler tasks 14 in 92 ms - the browser draws between
+// them, and the work takes no longer - and a timer is held to 4 ms apart once
+// it has nested a few deep.
+const TURN_MS = 6;
+
+const jobs: (() => void)[] = [];
+
+let scheduled = false;
+
+const runTurn = (): void =>
+{
+    scheduled = false;
+
+    const start = performance.now();
+
+    do jobs.shift()();
+    while(jobs.length && ((performance.now() - start) < TURN_MS));
+
+    if(jobs.length) schedule();
+}
+
+const schedule = (): void =>
+{
+    if(scheduled) return;
+
+    scheduled = true;
+
+    const scheduler = (globalThis as any).scheduler;
+
+    if(scheduler && (typeof scheduler.postTask === 'function'))
+    {
+        scheduler.postTask(runTurn, { priority: 'user-visible' });
+
+        return;
+    }
+
+    setTimeout(runTurn, 0);
+}
+
+export const UnpackSoon = <T>(work: () => T): Promise<T> => new Promise<T>((resolve, reject) =>
+{
+    jobs.push(() =>
+    {
+        try
+        {
+            resolve(work());
+        }
+        catch (error)
+        {
+            reject(error);
+        }
+    });
+
+    schedule();
+});
