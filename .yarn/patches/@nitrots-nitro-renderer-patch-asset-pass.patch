@@ -67,6 +71,13 @@
             return;
         }
 
+        // PixelRP: a file the asset pass gate turned away (403 - the pass had
+        // run out) still loads as before, so avatars draw without the piece
+        // rather than as a placeholder; but it is marked to be asked for again
+        // a minute later (isLoaded), where it used to stay missing until the
+        // page was reloaded. A 404 is a missing file and is left as it was.
+        this._refusedAt = ((status === 403) ? Date.now() : 0);
+
         this._state = AvatarAssetDownloadLibrary.LOADED;
 
         this.dispatchEvent(new AvatarRenderLibraryEvent(AvatarRenderLibraryEvent.DOWNLOAD_COMPLETE, this));
@@ -79,6 +90,14 @@
 
     public get isLoaded(): boolean
     {
+        // PixelRP: see downloadAsset - a refused file counts as loaded until a
+        // minute has passed, then the next avatar that needs it asks again.
+        if(this._refusedAt && ((Date.now() - this._refusedAt) >= AvatarAssetDownloadLibrary.REFUSED_RETRY_MS))
+        {
+            this._refusedAt = 0;
+            this._state = AvatarAssetDownloadLibrary.NOT_LOADED;
+        }
+
         return (this._state === AvatarAssetDownloadLibrary.LOADED);
     }
 }
