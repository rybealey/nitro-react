+    // PixelRP: the pixel at (x, y) of a picture drawn from these parts, each
+    // a container placed at (x, y) holding sprites cut from sheets, flipped
+    // or not (AvatarImageCache.createUnionImage). The pixel's centre is taken
+    // back through each sprite's placing to the texel drawn there, and that
+    // texel looked up in the frame's map. Null when a part is not one that
+    // can be read this way.
+    private static _partPoint: Point = new Point();
+
+    private static partsContainPoint(parts: DrawnPart[], x: number, y: number): boolean
+    {
+        const centreX = (Math.round(x) + 0.5);
+        const centreY = (Math.round(y) + 0.5);
+        const point = ExtendedSprite._partPoint;
+
+        for(const part of parts)
+        {
+            const image = part.image;
+
+            // Anything that changes how solid a pixel comes out, beyond the
+            // parts' own pixels, is left to the drawn picture.
+            if(!image || image.destroyed || (image.alpha !== 1) || (image.filters && image.filters.length)) return null;
+
+            image.transform.updateLocalTransform();
+            point.set((centreX - part.x), (centreY - part.y));
+            image.localTransform.applyInverse(point, point);
+
+            const imageX = point.x;
+            const imageY = point.y;
+
+            for(const child of image.children)
+            {
+                if(!(child instanceof Sprite)) return null;
+
+                const texture = child.texture;
+
+                if(!child.visible || (texture === Texture.EMPTY)) continue;
+
+                // A part drawn in place, like the avatar itself, has no map
+                // that stays true.
+                if(!texture || !texture.baseTexture || !texture.baseTexture.valid || texture.rotate || (texture.baseTexture instanceof BaseRenderTexture)) return null;
+
+                if((child.alpha !== 1) || (child.blendMode !== BLEND_MODES.NORMAL) || (child.filters && child.filters.length)) return null;
+
+                child.transform.updateLocalTransform();
+                point.set(imageX, imageY);
+                child.localTransform.applyInverse(point, point);
+
+                const texelX = (Math.floor(point.x) + (child.anchor.x * texture.orig.width));
+                const texelY = (Math.floor(point.y) + (child.anchor.y * texture.orig.height));
+
+                if((texelX < 0) || (texelY < 0) || (texelX >= texture.orig.width) || (texelY >= texture.orig.height)) continue;
