@@ -0,0 +1,23 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: add (true) or remove (false) a member on a shared album (owner
+// only; added members must be friends of the owner).
+export class RpAlbumMemberComposer implements IMessageComposer<ConstructorParameters<typeof RpAlbumMemberComposer>>
+{
+    private _data: ConstructorParameters<typeof RpAlbumMemberComposer>;
+
+    constructor(albumId: number, userId: number, add: boolean)
+    {
+        this._data = [ albumId, userId, add ];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
