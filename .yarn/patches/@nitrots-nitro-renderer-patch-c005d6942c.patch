diff --git a/src/nitro/communication/messages/incoming/RpAlbumListEvent.ts b/src/nitro/communication/messages/incoming/RpAlbumListEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c123fd98aa65e7d900951f0ce0ae76c49e288554
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpAlbumListEvent.ts
@@ -0,0 +1,89 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the phone Photos app's albums - every album the player owns or is
+// a member of. Cover is the album's latest photo ('' when empty); members
+// are listed for shared albums.
+export interface RpAlbumMember
+{
+    id: number;
+    name: string;
+}
+
+export interface RpAlbumListItem
+{
+    id: number;
+    name: string;
+    shared: boolean;
+    ownerId: number;
+    ownerName: string;
+    photoCount: number;
+    coverUrl: string;
+    members: RpAlbumMember[];
+}
+
+export class RpAlbumListParser implements IMessageParser
+{
+    private _albums: RpAlbumListItem[];
+
+    public flush(): boolean
+    {
+        this._albums = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._albums = [];
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            const id = wrapper.readInt();
+            const name = wrapper.readString();
+            const shared = wrapper.readBoolean();
+            const ownerId = wrapper.readInt();
+            const ownerName = wrapper.readString();
+            const photoCount = wrapper.readInt();
+            const coverUrl = wrapper.readString();
+            const members: RpAlbumMember[] = [];
+
+            let memberCount = wrapper.readInt();
+
+            while(memberCount > 0)
+            {
+                members.push({ id: wrapper.readInt(), name: wrapper.readString() });
+
+                memberCount--;
+            }
+
+            this._albums.push({ id, name, shared, ownerId, ownerName, photoCount, coverUrl, members });
+
+            count--;
+        }
+
+        return true;
+    }
+
+    public get albums(): RpAlbumListItem[]
+    {
+        return this._albums;
+    }
+}
+
+export class RpAlbumListEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpAlbumListParser);
+    }
+
+    public getParser(): RpAlbumListParser
+    {
+        return this.parser as RpAlbumListParser;
+    }
+}
diff --git a/src/nitro/communication/messages/incoming/RpAlbumPhotosEvent.ts b/src/nitro/communication/messages/incoming/RpAlbumPhotosEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b7867992450546e52e6dad324f6b257b3796460
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpAlbumPhotosEvent.ts
@@ -0,0 +1,75 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the photos inside one album, newest-added first. Shared albums
+// mix photos from every contributor, so each entry carries its owner.
+export interface RpAlbumPhoto
+{
+    id: number;
+    url: string;
+    timestamp: number;
+    ownerId: number;
+    ownerName: string;
+}
+
+export class RpAlbumPhotosParser implements IMessageParser
+{
+    private _albumId: number;
+    private _photos: RpAlbumPhoto[];
+
+    public flush(): boolean
+    {
+        this._albumId = 0;
+        this._photos = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._albumId = wrapper.readInt();
+        this._photos = [];
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            this._photos.push({
+                id: wrapper.readInt(),
+                url: wrapper.readString(),
+                timestamp: wrapper.readInt(),
+                ownerId: wrapper.readInt(),
+                ownerName: wrapper.readString()
+            });
+
+            count--;
+        }
+
+        return true;
+    }
+
+    public get albumId(): number
+    {
+        return this._albumId;
+    }
+
+    public get photos(): RpAlbumPhoto[]
+    {
+        return this._photos;
+    }
+}
+
+export class RpAlbumPhotosEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpAlbumPhotosParser);
+    }
+
+    public getParser(): RpAlbumPhotosParser
+    {
+        return this.parser as RpAlbumPhotosParser;
+    }
+}
