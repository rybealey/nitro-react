@@ -0,0 +1,23 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: create a photo album. Shared albums carry the initial member ids
+// (friends of the creator; the server validates).
+export class RpCreateAlbumComposer implements IMessageComposer<any[]>
+{
+    private _data: any[];
+
+    constructor(name: string, shared: boolean, memberIds: number[])
+    {
+        this._data = [ name, shared, memberIds.length, ...memberIds ];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        this._data = [];
+    }
+}
