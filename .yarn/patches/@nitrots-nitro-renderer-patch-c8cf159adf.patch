index 0000000000000000000000000000000000000000..6bbb2beec08d2f5e714395b2bf581bee04385163
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpMovementCycleEvent.ts
@@ -0,0 +1,82 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP movement authority: one walk step's authoritative timing, sent by
+// the server right after the UserUpdateComposer that carries its "mv" status.
+// cycleStart travels as a delta against the packet's own serverNow sample;
+// both are in the server's monotonic millisecond clock (TickCount64).
+export class RpMovementCycleParser implements IMessageParser
+{
+    private _virtualId: number;
+    private _seq: number;
+    private _onGrid: boolean;
+    private _fromX: number;
+    private _fromY: number;
+    private _fromZ: number;
+    private _toX: number;
+    private _toY: number;
+    private _toZ: number;
+    private _cycleStart: number;
+    private _interval: number;
+    private _serverNow: number;
+
+    public flush(): boolean
+    {
+        this._virtualId = -1;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._virtualId = wrapper.readInt();
+        this._seq = wrapper.readInt();
+        this._onGrid = (wrapper.readInt() === 1);
+        this._fromX = wrapper.readInt();
+        this._fromY = wrapper.readInt();
+        this._fromZ = (wrapper.readInt() / 100);
+        this._toX = wrapper.readInt();
+        this._toY = wrapper.readInt();
+        this._toZ = (wrapper.readInt() / 100);
+
+        const cycleStartDelta = wrapper.readInt();
+
+        this._interval = wrapper.readInt();
+
+        const serverNowHi = wrapper.readInt();
+        const serverNowLo = (wrapper.readInt() >>> 0);
+
+        this._serverNow = ((serverNowHi * 4294967296) + serverNowLo);
+        this._cycleStart = (this._serverNow + cycleStartDelta);
+
+        return true;
+    }
+
+    public get virtualId(): number { return this._virtualId; }
+    public get seq(): number { return this._seq; }
+    public get onGrid(): boolean { return this._onGrid; }
+    public get fromX(): number { return this._fromX; }
+    public get fromY(): number { return this._fromY; }
+    public get fromZ(): number { return this._fromZ; }
+    public get toX(): number { return this._toX; }
+    public get toY(): number { return this._toY; }
+    public get toZ(): number { return this._toZ; }
+    public get cycleStart(): number { return this._cycleStart; }
+    public get interval(): number { return this._interval; }
+    public get serverNow(): number { return this._serverNow; }
+}
+
+export class RpMovementCycleEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpMovementCycleParser);
+    }
+
+    public getParser(): RpMovementCycleParser
+    {
+        return this.parser as RpMovementCycleParser;
+    }
+}
