diff --git a/src/room/renderer/PixelRPMovementAuthority.ts b/src/room/renderer/PixelRPMovementAuthority.ts
new file mode 100644
index 0000000000000000000000000000000000000000..30972745110cec8dac38a9cc8c714fc4cad1009f
--- /dev/null
+++ b/src/room/renderer/PixelRPMovementAuthority.ts
@@ -0,0 +1,380 @@
+export interface PixelRPAuthorityEdge
+{
+    seq: number;
+    onGrid: boolean;
+    sx: number;
+    sy: number;
+    sz: number;
+    gx: number;
+    gy: number;
+    gz: number;
+    cycleStart: number;
+    interval: number;
+}
+
+export interface PixelRPAuthorityTarget
+{
+    x: number;
+    y: number;
+    z: number;
+}
+
+enum PixelRPAuthorityState
+{
+    NATIVE = 0,
+    ARMED = 1,
+    AUTHORITATIVE = 2
+}
+
+interface PixelRPAuthorityAvatar
+{
+    id: number;
+    state: PixelRPAuthorityState;
+    edges: PixelRPAuthorityEdge[];
+    lastSeq: number;
+    armSeq: number;
+    lastPacketAt: number;
+    lastRenderedX: number;
+    lastRenderedY: number;
+    lastRenderedZ: number;
+    lastRenderedAt: number;
+    endedAt: number;
+}
+
+/**
+ * PixelRP wire-authoritative movement (the primary sync architecture; the
+ * pairwise System 11 remains only as a fallback when no wire timing exists).
+ *
+ * The server schedules every walker's steps on ONE shared wall-clock 500ms
+ * grid and broadcasts each step's edge + cycleStart + interval + serverNow
+ * (RpMovementCycleComposer). Rendering is therefore a pure function:
+ *
+ *   position = lerp(edge, (estimatedServerNow - cycleStart) / interval)
+ *
+ * One grid = one cycle origin = one shared phase for every synchronized
+ * avatar - no sessions between avatars, no pairwise relationships, no phase
+ * acquisition, no convergence. Group walks fall out for free: each avatar
+ * resolves independently from the same clock.
+ *
+ * Clock offset: ONE monotonic estimate for the whole connection (min filter
+ * over clientNow - serverNow, refreshed on a rolling window). Packet arrival
+ * latency never redefines a per-avatar origin - a late packet still
+ * describes an edge whose cycleStart is already correct, so the avatar
+ * renders at the right phase the moment it arrives.
+ *
+ * Entry state machine per avatar: NATIVE -> ARMED -> AUTHORITATIVE. The
+ * instant/off-grid first step renders natively (local prediction stays
+ * responsive); the first on-grid edge arms; the switch happens atomically at
+ * the NEXT edge boundary (or immediately when visually continuous). While
+ * ARMED nothing chases the target and nothing reclassifies per frame.
+ *
+ * Remote avatars render REMOTE_RENDER_DELAY_MS behind server truth - a
+ * fixed, bounded jitter buffer so arrival jitter never becomes phase jitter.
+ * The local player's own avatar is never delayed.
+ *
+ * Stale protection: per-avatar monotonic seq; older packets are rejected
+ * before they can rewind slot, cycle, or state.
+ */
+export class PixelRPMovementAuthority
+{
+    private static readonly EDGE_QUEUE_SIZE = 6;
+    private static readonly REMOTE_RENDER_DELAY_MS = 45;
+    // Invisible-entry threshold (tiles) and the in-session frame guard,
+    // matching System 11's discrete discipline.
+    private static readonly MAX_ENTRY_DISCREPANCY = 0.08;
+    private static readonly MAX_CONTINUITY_DISCREPANCY = 0.22;
+    // No packet for this long = the walk is over (or authority lost): return
+    // to NATIVE discretely. The natural stop is snap-free anyway - the last
+    // edge's goal IS the native resting tile.
+    private static readonly PACKET_STALE_MS = 1400;
+    // How long past the last edge's window the clamped end position is held
+    // before releasing (covers server stalls without dropping authority).
+    private static readonly END_HOLD_MS = 700;
+    private static readonly INSTRUMENT_TRANSITIONS = true;
+
+    private static _instance: PixelRPMovementAuthority = null;
+
+    private readonly _avatars = new Map<number, PixelRPAuthorityAvatar>();
+    private _clockOffset = NaN;
+    private _clockWindowStart = 0;
+    private _clockWindowMin = NaN;
+
+    public static get instance(): PixelRPMovementAuthority
+    {
+        if(!PixelRPMovementAuthority._instance) PixelRPMovementAuthority._instance = new PixelRPMovementAuthority();
+
+        return PixelRPMovementAuthority._instance;
+    }
+
+    public record(virtualId: number, seq: number, onGrid: boolean,
+        sx: number, sy: number, sz: number, gx: number, gy: number, gz: number,
+        cycleStart: number, interval: number, serverNow: number, clientNow: number): void
+    {
+        this.updateClock(clientNow, serverNow);
+
+        let avatar = this._avatars.get(virtualId);
+
+        if(!avatar)
+        {
+            avatar = {
+                id: virtualId,
+                state: PixelRPAuthorityState.NATIVE,
+                edges: [],
+                lastSeq: -1,
+                armSeq: -1,
+                lastPacketAt: clientNow,
+                lastRenderedX: NaN,
+                lastRenderedY: NaN,
+                lastRenderedZ: NaN,
+                lastRenderedAt: 0,
+                endedAt: 0
+            };
+
+            this._avatars.set(virtualId, avatar);
+        }
+
+        // Stale / out-of-order protection: an older or duplicate packet must
+        // never rewind slot, cycle or state.
+        if(seq <= avatar.lastSeq) return;
+
+        // A new walk after a gap starts a fresh entry decision.
+        if((clientNow - avatar.lastPacketAt) > PixelRPMovementAuthority.PACKET_STALE_MS)
+        {
+            avatar.edges = [];
+            avatar.state = PixelRPAuthorityState.NATIVE;
+            avatar.armSeq = -1;
+        }
+
+        avatar.lastSeq = seq;
+        avatar.lastPacketAt = clientNow;
+        // endedAt is getTarget's hold marker - it must survive this packet's
+        // arrival so the first render of a LATE edge is recognized as the
+        // sanctioned resume-from-hold correction.
+        avatar.edges.push({ seq, onGrid, sx, sy, sz, gx, gy, gz, cycleStart, interval: ((interval > 0) ? interval : 500) });
+
+        if(avatar.edges.length > PixelRPMovementAuthority.EDGE_QUEUE_SIZE)
+        {
+            avatar.edges.splice(0, (avatar.edges.length - PixelRPMovementAuthority.EDGE_QUEUE_SIZE));
+        }
+
+        if(this._avatars.size > 128)
+        {
+            for(const [ id, item ] of this._avatars)
+            {
+                if((clientNow - item.lastPacketAt) > 5000) this._avatars.delete(id);
+            }
+        }
+    }
+
+    public isAuthoritative(virtualId: number): boolean
+    {
+        const avatar = this._avatars.get(virtualId);
+
+        return !!(avatar && (avatar.state === PixelRPAuthorityState.AUTHORITATIVE));
+    }
+
+    public getTarget(virtualId: number, clientNow: number, isOwn: boolean,
+        nativeX: number, nativeY: number, nativeZ: number): PixelRPAuthorityTarget
+    {
+        const avatar = this._avatars.get(virtualId);
+
+        if(!avatar || !Number.isFinite(this._clockOffset)) return null;
+
+        if((clientNow - avatar.lastPacketAt) > PixelRPMovementAuthority.PACKET_STALE_MS)
+        {
+            this.releaseAvatar(avatar, 'packet-stale');
+            return null;
+        }
+
+        const estServerNow = (clientNow - this._clockOffset - (isOwn ? 0 : PixelRPMovementAuthority.REMOTE_RENDER_DELAY_MS));
+
+        // The edge whose window contains estServerNow (latest started edge).
+        let edge: PixelRPAuthorityEdge = null;
+
+        for(let index = (avatar.edges.length - 1); index >= 0; index--)
+        {
+            if(avatar.edges[index].cycleStart <= estServerNow) { edge = avatar.edges[index]; break; }
+        }
+
+        if(!edge || !edge.onGrid)
+        {
+            // Nothing renderable yet (all edges in the future, or only the
+            // off-grid instant first step): stay native. Off-grid edges are
+            // the local-prediction / responsiveness path by design.
+            return null;
+        }
+
+        const rawPhase = ((estServerNow - edge.cycleStart) / edge.interval);
+        const phase = Math.min(1, Math.max(0, rawPhase));
+
+        // Past the last known window: the walker is stopping (its goal is the
+        // native resting tile - a snap-free exit) or the next packet is late.
+        // Hold the clamped end briefly, then release discretely.
+        let resumedFromHold = false;
+
+        if((rawPhase > 1) && (edge === avatar.edges[avatar.edges.length - 1]))
+        {
+            if(avatar.state !== PixelRPAuthorityState.AUTHORITATIVE) return null;
+
+            if(!avatar.endedAt) avatar.endedAt = clientNow;
+
+            if((clientNow - avatar.endedAt) > PixelRPMovementAuthority.END_HOLD_MS)
+            {
+                this.releaseAvatar(avatar, 'walk-ended');
+                return null;
+            }
+        }
+        else
+        {
+            // Coming out of an end-of-window hold means the next packet was
+            // late: the first render of its edge is a single sanctioned
+            // discrete correction (bounded by END_HOLD_MS of walking), not a
+            // continuity violation.
+            resumedFromHold = (avatar.endedAt > 0);
+            avatar.endedAt = 0;
+        }
+
+        const target: PixelRPAuthorityTarget = {
+            x: (edge.sx + ((edge.gx - edge.sx) * phase)),
+            y: (edge.sy + ((edge.gy - edge.sy) * phase)),
+            z: (edge.sz + ((edge.gz - edge.sz) * phase))
+        };
+
+        if(avatar.state !== PixelRPAuthorityState.AUTHORITATIVE)
+        {
+            const displacement = this.tileDistance(nativeX, nativeY, nativeZ, target.x, target.y, target.z);
+
+            if(displacement <= PixelRPMovementAuthority.MAX_ENTRY_DISCREPANCY)
+            {
+                // Visually continuous: enter immediately.
+                this.enter(avatar, edge, phase, displacement, 'immediate-continuous', target);
+            }
+            else if(avatar.state === PixelRPAuthorityState.NATIVE)
+            {
+                // Not continuous: arm ONCE on this edge and switch at the
+                // next edge boundary. No per-frame reclassification, no
+                // chasing - native rendering continues untouched meanwhile.
+                avatar.state = PixelRPAuthorityState.ARMED;
+                avatar.armSeq = edge.seq;
+                this.logEvent('AUTH_HANDOFF_PENDING', avatar, edge, phase, displacement, 'armed-await-boundary', nativeX, nativeY, target);
+                return null;
+            }
+            else if(edge.seq > avatar.armSeq)
+            {
+                if(displacement > 2.5)
+                {
+                    // A real route step cannot explain this gap (teleport
+                    // race / desynced native object): re-arm and let native
+                    // state settle before the next boundary.
+                    avatar.armSeq = edge.seq;
+                    this.logEvent('AUTH_HANDOFF_REJECT', avatar, edge, phase, displacement, 'handoff-distance-unsafe', nativeX, nativeY, target);
+                    return null;
+                }
+
+                // Boundary passed: the single discrete switch. The target sits
+                // at (or within a frame of) a real route vertex.
+                this.enter(avatar, edge, phase, displacement, 'boundary-switch', target);
+            }
+            else
+            {
+                return null; // still ARMED within the arming edge
+            }
+        }
+        else
+        {
+            // In-session frame guard: mirrors bounded server jitter, releases
+            // on anything a real route step cannot explain.
+            const elapsed = Math.min(100, Math.max(1, (clientNow - avatar.lastRenderedAt)));
+            const proposedDelta = this.tileDistance(avatar.lastRenderedX, avatar.lastRenderedY, avatar.lastRenderedZ, target.x, target.y, target.z);
+            const maxSaneDelta = Math.min(0.27, (PixelRPMovementAuthority.MAX_CONTINUITY_DISCREPANCY + (elapsed / edge.interval)));
+
+            if(!resumedFromHold && Number.isFinite(avatar.lastRenderedX) && (proposedDelta > maxSaneDelta))
+            {
+                this.releaseAvatar(avatar, 'impossible-frame-displacement');
+                return null;
+            }
+        }
+
+        avatar.lastRenderedX = target.x;
+        avatar.lastRenderedY = target.y;
+        avatar.lastRenderedZ = target.z;
+        avatar.lastRenderedAt = clientNow;
+
+        return target;
+    }
+
+    private enter(avatar: PixelRPAuthorityAvatar, edge: PixelRPAuthorityEdge, phase: number,
+        displacement: number, reason: string, target: PixelRPAuthorityTarget): void
+    {
+        avatar.state = PixelRPAuthorityState.AUTHORITATIVE;
+        avatar.lastRenderedX = target.x;
+        avatar.lastRenderedY = target.y;
+        avatar.lastRenderedZ = target.z;
+        this.logEvent('AUTH_HANDOFF_ENTER', avatar, edge, phase, displacement, reason, NaN, NaN, target);
+    }
+
+    private releaseAvatar(avatar: PixelRPAuthorityAvatar, reason: string): void
+    {
+        if(avatar.state === PixelRPAuthorityState.AUTHORITATIVE)
+        {
+            this.logEvent('AUTH_EXIT', avatar, avatar.edges[avatar.edges.length - 1] || null, NaN, NaN, reason, NaN, NaN, null);
+        }
+
+        avatar.state = PixelRPAuthorityState.NATIVE;
+        avatar.armSeq = avatar.lastSeq;
+        avatar.endedAt = 0;
+        avatar.lastRenderedX = NaN;
+    }
+
+    /**
+     * One stable monotonic clock-offset estimate shared by ALL avatars: the
+     * minimum observed (clientNow - serverNow) - the fastest packet - over a
+     * rolling window, so per-packet arrival latency never becomes a phase
+     * origin. A jump beyond any plausible drift (server restart / reconnect)
+     * rebases outright; that shifts every avatar's phase IDENTICALLY, never
+     * differentially.
+     */
+    private updateClock(clientNow: number, serverNow: number): void
+    {
+        const sample = (clientNow - serverNow);
+
+        if(!Number.isFinite(this._clockOffset) || (Math.abs(sample - this._clockOffset) > 5000))
+        {
+            this._clockOffset = sample;
+            this._clockWindowStart = clientNow;
+            this._clockWindowMin = sample;
+            return;
+        }
+
+        if(sample < this._clockOffset) this._clockOffset = sample;
+
+        // Rolling 30s window tracks upward drift (clock skew) without ever
+        // letting one slow packet drag the estimate.
+        this._clockWindowMin = Number.isFinite(this._clockWindowMin) ? Math.min(this._clockWindowMin, sample) : sample;
+
+        if((clientNow - this._clockWindowStart) > 30000)
+        {
+            this._clockOffset = this._clockWindowMin;
+            this._clockWindowStart = clientNow;
+            this._clockWindowMin = NaN;
+        }
+    }
+
+    private tileDistance(ax: number, ay: number, az: number, bx: number, by: number, bz: number): number
+    {
+        return Math.max(Math.abs(ax - bx), Math.abs(ay - by), Math.abs(az - bz));
+    }
+
+    private logEvent(event: string, avatar: PixelRPAuthorityAvatar, edge: PixelRPAuthorityEdge,
+        phase: number, handoffDistance: number, reason: string,
+        nativeX: number, nativeY: number, target: PixelRPAuthorityTarget): void
+    {
+        if(!PixelRPMovementAuthority.INSTRUMENT_TRANSITIONS) return;
+
+        const slot = edge ? edge.seq : NaN;
+        const nativePosition = (Number.isFinite(nativeX) && Number.isFinite(nativeY)) ? `${ nativeX.toFixed(2) },${ nativeY.toFixed(2) }` : 'n/a';
+        const authoritativePosition = target ? `${ target.x.toFixed(2) },${ target.y.toFixed(2) }` : 'n/a';
+
+        console.log(`[${ event }] avatarId=${ avatar.id } routeSlot=${ Number.isFinite(slot) ? slot : 'n/a' } sharedPhase=${ Number.isFinite(phase) ? phase.toFixed(3) : 'n/a' } nativePosition=${ nativePosition } authoritativePosition=${ authoritativePosition } handoffDistance=${ Number.isFinite(handoffDistance) ? handoffDistance.toFixed(3) : 'n/a' } clockOffset=${ Number.isFinite(this._clockOffset) ? Math.round(this._clockOffset) : 'n/a' } reason=${ reason }`);
+    }
+}
