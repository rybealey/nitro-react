index 0000000000000000000000000000000000000000..a5a1424c180b0d32396f46c64ef5b278dcbca19f
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpOpenFloorplanEvent.ts
@@ -0,0 +1,30 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: pure signal telling the client to open the floor plan editor.
+// No payload - the server never sends any fields for this packet.
+export class RpOpenFloorplanParser implements IMessageParser
+{
+    public flush(): boolean
+    {
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        return true;
+    }
+}
+
+export class RpOpenFloorplanEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpOpenFloorplanParser);
+    }
+
+    public getParser(): RpOpenFloorplanParser
+    {
+        return this.parser as RpOpenFloorplanParser;
+    }
+}
