index 0000000000000000000000000000000000000000..57065b86fa86181ed14e6fe96f7fb245d83ce4ac
--- /dev/null
+++ b/src/nitro/communication/messages/outgoing/RpMoveItemComposer.ts
@@ -0,0 +1,22 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: move/swap the backpack item in carry slot `from` into `to`.
+export class RpMoveItemComposer implements IMessageComposer<ConstructorParameters<typeof RpMoveItemComposer>>
+{
+    private _data: ConstructorParameters<typeof RpMoveItemComposer>;
+
+    constructor(from: number, to: number)
+    {
+        this._data = [from, to];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
