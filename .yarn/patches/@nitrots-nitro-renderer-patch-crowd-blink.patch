+    /**
+     * PixelRP (Twist, 2026-10-27): whether this avatar's blink goes unshown.
+     * Every avatar blinks every five seconds or so, and each blink rebuilt it
+     * twice (eyes shut, eyes open) - about 20 rebuilds a second in a room of 50
+     * with nobody moving. Never your own avatar. Every other one zoomed out,
+     * where a blink is too small to see (updateScale already hid it, but only
+     * after the rebuild), and in a crowd: PIXELRP_CROWD players or more in the
+     * room, counted from the room's own units, so the count cannot drift.
+     */
+    private pixelrpQuietBlink(model: IRoomObjectModel, scale: number): boolean
+    {
+        if(model.getValue<number>(RoomObjectVariable.OWN_USER) > 0) return false;
+
+        if(scale < 48) return true;
+
+        const now = Date.now();
+
+        if((now - AvatarVisualization._pixelrpCrowdCheckedAt) >= AvatarVisualization.PIXELRP_CROWD_CHECK_MS)
+        {
+            AvatarVisualization._pixelrpCrowdCheckedAt = now;
+
+            const roomEngine = Nitro.instance?.roomEngine;
+            const units = (roomEngine ? roomEngine.getRoomObjects(roomEngine.activeRoomId, RoomObjectCategory.UNIT) : null);
+
+            let players = 0;
+
+            if(units) for(const unit of units) if(unit && (unit.type === 'user')) players++;
+
+            AvatarVisualization._pixelrpCrowded = (players >= AvatarVisualization.PIXELRP_CROWD);
+        }
+
+        return AvatarVisualization._pixelrpCrowded;
+    }
