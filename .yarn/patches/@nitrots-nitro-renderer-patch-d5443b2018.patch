@@ -0,0 +1,22 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: request the session user's Discord link status.
+export class RpGetDiscordStatusComposer implements IMessageComposer<ConstructorParameters<typeof RpGetDiscordStatusComposer>>
+{
+    private _data: ConstructorParameters<typeof RpGetDiscordStatusComposer>;
+
+    constructor()
+    {
+        this._data = [];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
