diff --git a/src/nitro/communication/messages/incoming/RpDiscordStatusEvent.ts b/src/nitro/communication/messages/incoming/RpDiscordStatusEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf3ee774567ad8f7d93649a9c92b93282f26f5fa
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpDiscordStatusEvent.ts
@@ -0,0 +1,43 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: whether the session user's Discord is linked - a bare boolean by
+// design (Discord details never reach the client).
+export class RpDiscordStatusParser implements IMessageParser
+{
+    private _linked: boolean;
+
+    public flush(): boolean
+    {
+        this._linked = false;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._linked = (wrapper.readInt() === 1);
+
+        return true;
+    }
+
+    public get linked(): boolean
+    {
+        return this._linked;
+    }
+}
+
+export class RpDiscordStatusEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpDiscordStatusParser);
+    }
+
+    public getParser(): RpDiscordStatusParser
+    {
+        return this.parser as RpDiscordStatusParser;
+    }
+}
