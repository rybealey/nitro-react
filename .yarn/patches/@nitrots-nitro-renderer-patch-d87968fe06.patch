diff --git a/src/nitro/communication/messages/incoming/RpCorpDetailEvent.ts b/src/nitro/communication/messages/incoming/RpCorpDetailEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f9f1eefa1a232c75e9dd502845dbdefef7934c63
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpCorpDetailEvent.ts
@@ -0,0 +1,133 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: one corporation in full - the rank ladder (pay per 10-minute
+// shift interval, tier ceiling) and the employees at each rank.
+export interface RpCorpEmployee
+{
+    username: string;
+    figure: string;
+    tier: number;
+    online: boolean;
+    onDuty: boolean;
+}
+
+export interface RpCorpRank
+{
+    id: number;
+    order: number;
+    name: string;
+    pay: number;
+    tiers: number;
+    employees: RpCorpEmployee[];
+}
+
+export class RpCorpDetailParser implements IMessageParser
+{
+    private _corpId: number;
+    private _name: string;
+    private _badge: string;
+    private _description: string;
+    private _employeeCount: number;
+    private _ranks: RpCorpRank[];
+
+    public flush(): boolean
+    {
+        this._corpId = 0;
+        this._name = '';
+        this._badge = '';
+        this._description = '';
+        this._employeeCount = 0;
+        this._ranks = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._corpId = wrapper.readInt();
+        this._name = wrapper.readString();
+        this._badge = wrapper.readString();
+        this._description = wrapper.readString();
+        this._employeeCount = wrapper.readInt();
+        this._ranks = [];
+
+        let rankCount = wrapper.readInt();
+
+        while(rankCount > 0)
+        {
+            const id = wrapper.readInt();
+            const order = wrapper.readInt();
+            const name = wrapper.readString();
+            const pay = wrapper.readInt();
+            const tiers = wrapper.readInt();
+            const employees: RpCorpEmployee[] = [];
+
+            let employeeCount = wrapper.readInt();
+
+            while(employeeCount > 0)
+            {
+                const username = wrapper.readString();
+                const figure = wrapper.readString();
+                const tier = wrapper.readInt();
+                const online = (wrapper.readInt() === 1);
+                const onDuty = (wrapper.readInt() === 1);
+
+                employees.push({ username, figure, tier, online, onDuty });
+
+                employeeCount--;
+            }
+
+            this._ranks.push({ id, order, name, pay, tiers, employees });
+
+            rankCount--;
+        }
+
+        return true;
+    }
+
+    public get corpId(): number
+    {
+        return this._corpId;
+    }
+
+    public get name(): string
+    {
+        return this._name;
+    }
+
+    public get badge(): string
+    {
+        return this._badge;
+    }
+
+    public get description(): string
+    {
+        return this._description;
+    }
+
+    public get employeeCount(): number
+    {
+        return this._employeeCount;
+    }
+
+    public get ranks(): RpCorpRank[]
+    {
+        return this._ranks;
+    }
+}
+
+export class RpCorpDetailEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpCorpDetailParser);
+    }
+
+    public getParser(): RpCorpDetailParser
+    {
+        return this.parser as RpCorpDetailParser;
+    }
+}
diff --git a/src/nitro/communication/messages/incoming/RpCorpsEvent.ts b/src/nitro/communication/messages/incoming/RpCorpsEvent.ts
