index 0000000000000000000000000000000000000000..d54b87434a102904c721ec8aeb8277ebdd5ea272
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpCorpsEvent.ts
@@ -0,0 +1,65 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the corporations directory for the Corporations window's rail -
+// every corporation with its badge code ('' = default) and employee count.
+export interface RpCorpEntry
+{
+    id: number;
+    name: string;
+    badge: string;
+    employees: number;
+}
+
+export class RpCorpsParser implements IMessageParser
+{
+    private _corps: RpCorpEntry[];
+
+    public flush(): boolean
+    {
+        this._corps = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._corps = [];
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            const id = wrapper.readInt();
+            const name = wrapper.readString();
+            const badge = wrapper.readString();
+            const employees = wrapper.readInt();
+
+            this._corps.push({ id, name, badge, employees });
+
+            count--;
+        }
+
+        return true;
+    }
+
+    public get corps(): RpCorpEntry[]
+    {
+        return this._corps;
+    }
+}
+
+export class RpCorpsEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpCorpsParser);
+    }
+
+    public getParser(): RpCorpsParser
+    {
+        return this.parser as RpCorpsParser;
+    }
+}
