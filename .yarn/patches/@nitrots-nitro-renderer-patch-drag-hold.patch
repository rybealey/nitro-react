     // PixelRP: per room, the tile the own avatar arrived on and where a room
     // bigger than the screen was centred for it (pixelrpRoomAreaTarget).
     private _pixelrpArrivals: Map<number, { x: number, y: number, target: Vector3d }> = new Map();
+
+    // PixelRP: a room the player has dragged - which room, the tile their
+    // avatar stood on, and the zoom and screen size at the time (pixelrpHoldCamera).
+    private _pixelrpDragHold: { roomId: number, x: number, y: number, scale: number, width: number, height: number } = null;
+
+    /**
+     * PixelRP: the player dragged the room, so the camera stops steering it.
+     * A camera move still under way is dropped, and so is the arrival aim, and
+     * the room stays where it was put until pixelrpDragHolds lets go. Without
+     * this a drag straight after entering snapped back: the avatar's location
+     * changes a few times as a room loads (its height as the furni under it
+     * arrives, its first status), every change set the camera re-aiming, and a
+     * floor that fits on screen is always re-centred.
+     */
+    private pixelrpHoldCamera(): void
+    {
+        const camera = this.getRoomCamera(this._activeRoomId);
+        const canvas = this.getRoomCanvasRectangle(this._activeRoomId, 1);
+        const geometry = this.getRoomInstanceGeometry(this._activeRoomId, 1);
+
+        if(!camera || !canvas || !geometry) return;
+
+        camera.stopMoving();
+
+        this._pixelrpArrivals.delete(this._activeRoomId);
+
+        const avatar = this.getRoomObject(this._activeRoomId, camera.targetId, camera.targetCategory);
+        const location = (avatar ? avatar.getLocation() : null);
+
+        this._pixelrpDragHold = {
+            roomId: this._activeRoomId,
+            x: (location ? Math.round(location.x) : NaN),
+            y: (location ? Math.round(location.y) : NaN),
+            scale: geometry.scale,
+            width: Math.round(canvas.width),
+            height: Math.round(canvas.height)
+        };
+    }
+
+    /**
+     * PixelRP: true while a dragged room should stay put - the avatar is still
+     * on the tile it stood on, at the same zoom and screen size. A step, a
+     * teleport, a zoom or a resized window hands the room back to the camera.
+     */
+    private pixelrpDragHolds(roomId: number, avatar: IVector3D, camera: RoomCamera, scale: number, width: number, height: number): boolean
+    {
+        const hold = this._pixelrpDragHold;
+
+        if(!hold || (hold.roomId !== roomId)) return false;
+
+        const x = Math.round(avatar.x);
+        const y = Math.round(avatar.y);
+
+        // Dragged before the own avatar was in the room: hold from where it is.
+        if(isNaN(hold.x))
+        {
+            hold.x = x;
+            hold.y = y;
+        }
+
+        if((x === hold.x) && (y === hold.y) && (scale === hold.scale) && (width === hold.width) && (height === hold.height))
+        {
+            // The camera's record of the screen, which a drag straight after
+            // entering can beat it to: otherwise the first step re-aims for a
+            // "new" screen size and the room snaps back then instead.
+            camera.screenWd = width;
+            camera.screenHt = height;
+
+            return true;
+        }
+
+        this._pixelrpDragHold = null;
+
+        return false;
+    }
 
     // PixelRP: how far below the middle of the screen the floor's centre goes,
     // as a share of the window's height - a little nearer the chat box.
