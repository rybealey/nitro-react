     public get avatarSpriteData(): IAvatarDataContainer
     {
         return this._avatarSpriteData;
+    }
+
+    // PixelRP (Twist, 2026-10-28): true when none of these filters changes a
+    // pixel's alpha, so the click test can still read the parts (pixelrpParts
+    // in getImage). The palette map writes the colour and keeps the
+    // alpha; an AdjustmentFilter multiplies the alpha by its own (an effect's
+    // ink 37 is 0.5, and that one still goes to the drawn picture); a colour
+    // matrix keeps it when its alpha row is 0 0 0 1 0, as the grey one is.
+    // Anything else is left to the drawn picture, as before.
+    private static pixelrpKeepsSolid(filters: unknown[]): boolean
+    {
+        if(!filters || !filters.length) return true;
+
+        for(const filter of filters)
+        {
+            if(filter instanceof PaletteMapFilter) continue;
+
+            if(filter instanceof AdjustmentFilter)
+            {
+                if(filter.alpha === 1) continue;
+
+                return false;
+            }
+
+            if(filter instanceof ColorMatrixFilter)
+            {
+                const matrix = filter.matrix;
+
+                if(matrix && (matrix[15] === 0) && (matrix[16] === 0) && (matrix[17] === 0) && (matrix[18] === 1) && (matrix[19] === 0)) continue;
+
+                return false;
+            }
+
+            return false;
+        }
+
+        return true;
     }
 
