 // uploading them all again (600 was ~10s).
 settings.GC_MAX_IDLE = 1800;
 
+// PixelRP: a sheet marked pixelrpKeepOnGpu - an avatar clothing library
+// (AvatarAssetDownloadLibrary) - counts as just used at every sweep, so the
+// texture GC never drops it. Clothes are only drawn when an avatar changes,
+// and an avatar standing still (asleep, it does not even blink) left them
+// unused long enough to be dropped; its first step then put every one back
+// on the GPU at once, unpacking each PNG again in that frame. The same few
+// libraries dress almost everybody, so keeping them costs little memory.
+const runTextureGC = TextureGCSystem.prototype.run;
+
+TextureGCSystem.prototype.run = function(this: TextureGCSystem): void
+{
+    //@ts-ignore - the renderer is private in the typings
+    const managed = (this.renderer?.texture?.managedTextures as BaseTexture[]);
+
+    if(managed)
+    {
+        for(const texture of managed)
+        {
+            //@ts-ignore
+            if(texture && texture.pixelrpKeepOnGpu) texture.touched = this.count;
+        }
+    }
+
+    runTextureGC.call(this);
+};
+
