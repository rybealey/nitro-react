+
+    /**
+     * flags bit 0x0400 - pixelrp pepper spray (RpMovementV2Flags.FixedFacing):
+     * the server faces this edge itself, and timingGroupId (field 6, which the
+     * escort bit borrows too - never on the same edge) carries the facing,
+     * 0-7. A sprayed player stumbles back still facing the officer, so their
+     * steps must not be faced by the way they move.
+     *
+     * -1 when the bit is unset, and from an emulator that does not set it.
+     */
+    public get fixedFacing(): number { return ((this._flags & 0x0400) !== 0) ? this._timingGroupId : -1; }
 }
 
