diff --git a/src/room/object/RoomObjectModel.ts b/src/room/object/RoomObjectModel.ts
index 1111111..2222222 100644
--- a/src/room/object/RoomObjectModel.ts
+++ b/src/room/object/RoomObjectModel.ts
@@ -29,7 +29,14 @@
     {
         if(this._map.has(key))
         {
-            if(this._map.get(key) === value) return;
+            const existing = this._map.get(key);
+
+            // PixelRP: NaN over NaN is no change either. === never holds for
+            // NaN, so a NaN written again counted as a change every time - the
+            // flat control of everyone without rights is NaN, written on every
+            // status update, so every avatar re-read its whole model twice a
+            // second for nothing.
+            if((existing === value) || ((existing !== existing) && (value !== value))) return;
         }
 
         this._map.set(key, (value as T));
