+    // takes. Unset is solid.
+    private updateFloorAlpha(k: IRoomObjectModel): boolean
+    {
+        if(this.updateModelCounter === k.updateCounter) return false;
+
+        const value = k.getValue<number>(RoomObjectVariable.ROOM_FLOOR_ALPHA);
