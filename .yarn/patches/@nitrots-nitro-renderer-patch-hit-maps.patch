+    // PixelRP: only a still picture cut from a larger one - a render texture
+    // can be redrawn in place with nobody to tell its maps, and a rotated
+    // frame is stored sideways in its sheet; both keep the whole-texture map.
+    private static hasFrameHitMap(texture: Texture): boolean
+    {
+        const baseTexture = texture.baseTexture;
+
+        if((baseTexture instanceof BaseRenderTexture) || texture.rotate) return false;
+
+        return ((texture.frame.width < baseTexture.width) || (texture.frame.height < baseTexture.height));
+    }
+
+    private static frameContainsPoint(texture: Texture, x: number, y: number): boolean
+    {
+        const frame = texture.frame;
+        const baseTexture = texture.baseTexture;
+
+        //@ts-ignore
+        if(!baseTexture.frameHitMaps) baseTexture.frameHitMaps = new Map();
+
+        //@ts-ignore
+        const maps = (baseTexture.frameHitMaps as Map<string, FrameHitMap>);
+        const key = `${ frame.x },${ frame.y },${ frame.width },${ frame.height }`;
+
+        let hitMap = maps.get(key);
+
+        if(!hitMap)
+        {
+            hitMap = ExtendedSprite.generateFrameHitMap(texture);
+
+            maps.set(key, hitMap);
+        }
+
+        if(texture.trim)
+        {
+            x -= texture.trim.x;
+            y -= texture.trim.y;
+        }
+
+        const dx = Math.round(x);
+        const dy = Math.round(y);
+
+        if((dx < 0) || (dy < 0) || (dx >= hitMap.width) || (dy >= hitMap.height)) return false;
+
+        const ind = (dx + (dy * hitMap.width));
+
+        return (hitMap.bits[ind >>> 5] & (1 << (ind & 31))) !== 0;
+    }
+
+    // Drawn at resolution 1 into a texture the frame's own size, so the
+    // readback is just the frame and one map pixel is one texture unit.
+    private static generateFrameHitMap(texture: Texture): FrameHitMap
+    {
+        const width = Math.max(1, Math.ceil(texture.frame.width));
+        const height = Math.max(1, Math.ceil(texture.frame.height));
+        const frameTexture = new Texture(texture.baseTexture, texture.frame.clone());
+        const sprite = new Sprite(frameTexture);
+        const renderTexture = TextureUtils.generateTexture(sprite, new Rectangle(0, 0, width, height));
+        const pixels = TextureUtils.getPixels(renderTexture);
+        const bits = new Uint32Array(Math.ceil(width * height / 32));
+        const threshold = AlphaTolerance.MATCH_OPAQUE_PIXELS;
+
+        for(let i = 0; i < width * height; i++)
+        {
+            if(pixels[i * 4 + 3] >= threshold) bits[i >>> 5] |= (1 << (i & 31));
+        }
+
+        renderTexture.destroy(true);
+        sprite.destroy();
+        frameTexture.destroy();
+
+        return { width, height, bits };
+    }
