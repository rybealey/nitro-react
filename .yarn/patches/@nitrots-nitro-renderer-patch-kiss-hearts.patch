diff --git a/src/nitro/room/object/visualization/avatar/additions/LoveHeartAddition.ts b/src/nitro/room/object/visualization/avatar/additions/LoveHeartAddition.ts
new file mode 100644
index 0000000..742f2de
--- /dev/null
+++ b/src/nitro/room/object/visualization/avatar/additions/LoveHeartAddition.ts
@@ -0,0 +1,131 @@
+import { BLEND_MODES } from '@pixi/constants';
+import { Resource, Texture } from '@pixi/core';
+import { Matrix } from '@pixi/math';
+import { IGraphicAsset, IRoomObjectSprite } from '../../../../../../api';
+import { GetTickerTime, NitroSprite, TextureUtils } from '../../../../../../pixi-proxy';
+import { AvatarVisualization } from '../AvatarVisualization';
+import { IAvatarAddition } from './IAvatarAddition';
+
+/**
+ * pixelrp: one of the three hearts that float over both people in a :kiss.
+ *
+ * Habbo's fx 9 ("Love") drawn as an addition instead of worn as an effect. An
+ * avatar wears one effect at a time, and the handcuffs, the stun's birds, the
+ * ambulance and the staff and passive markers are all effects - wearing Love
+ * would take them off for the length of the kiss. An addition sits beside the
+ * effect the way the typing bubble and the sleeping Zzz do.
+ *
+ * Each heart replays one of Love's three sprite tracks. The art and its
+ * offsets come from the effect's own library, and the sprite is placed with
+ * the formula AvatarVisualization uses for an effect's sprites, so the hearts
+ * land where Habbo draws them. Love only ships the large size; zoomed out,
+ * each frame is drawn at half size from it.
+ */
+export class LoveHeartAddition implements IAvatarAddition
+{
+    public static EFFECT_ID: number = 9;
+
+    private static FRAME_COUNT: number = 21;
+    // One avatar animation frame. AvatarVisualization updates every 41ms but moves
+    // an effect on only every second update (ANIMATION_FRAME_UPDATE_INTERVAL).
+    private static FRAME_LENGTH: number = 82;
+    // Love's sprites fx9_1-3: where each starts in the loop, and how far it sits from the first.
+    private static TRACKS: { start: number, dx: number, dy: number }[] = [
+        { start: 0, dx: 0, dy: 0 },
+        { start: 10, dx: 10, dy: -3 },
+        { start: 14, dx: 18, dy: 2 }
+    ];
+    private static SMALL_TEXTURES: Map<string, Texture<Resource>> = new Map();
+
+    private _id: number;
+    private _track: number;
+    private _visualization: AvatarVisualization;
+    private _startTime: number;
+    private _scale: number;
+    private _requested: boolean;
+
+    constructor(id: number, track: number, visualization: AvatarVisualization)
+    {
+        this._id = id;
+        this._track = track;
+        this._visualization = visualization;
+        this._startTime = GetTickerTime();
+        this._scale = 64;
+        this._requested = false;
+    }
+
+    public dispose(): void
+    {
+        this._visualization = null;
+    }
+
+    public update(sprite: IRoomObjectSprite, scale: number): void
+    {
+        if(!sprite) return;
+
+        this._scale = scale;
+
+        this.animate(sprite);
+    }
+
+    public animate(sprite: IRoomObjectSprite): boolean
+    {
+        if(!sprite || !this._visualization) return false;
+
+        const track = LoveHeartAddition.TRACKS[this._track];
+        const frame = ((track.start + Math.floor((GetTickerTime() - this._startTime) / LoveHeartAddition.FRAME_LENGTH)) % LoveHeartAddition.FRAME_COUNT);
+        const asset = this._visualization.getAvatarRenderGraphicAsset('h_std_fx9_1_1_0_' + frame);
+
+        if(!asset || !asset.texture)
+        {
+            // Nobody has worn Love yet this session, so its library was never
+            // fetched. Ask once; the hearts appear as soon as it lands.
+            if(!this._requested)
+            {
+                this._requested = true;
+
+                this._visualization.downloadAvatarEffect(LoveHeartAddition.EFFECT_ID);
+            }
+
+            sprite.visible = false;
+
+            return false;
+        }
+
+        const half = ((this._scale < 48) ? 0.5 : 1);
+
+        sprite.texture = ((half < 1) ? LoveHeartAddition.getSmallTexture(asset) : asset.texture);
+        sprite.offsetX = (((asset.offsetX + track.dx) * half) - (this._scale / 2));
+        sprite.offsetY = (((asset.offsetY + track.dy) * half) + this._visualization.postureOffset);
+        sprite.flipH = asset.flipH;
+        // Love is ink 33, which an effect draws additively - what lightens the
+        // hearts against dark hair and walls. AvatarVisualization puts every
+        // addition back to NORMAL before it is handed a sprite.
+        sprite.blendMode = BLEND_MODES.ADD;
+        sprite.alpha = 255;
+        sprite.relativeDepth = -0.02;
+        sprite.visible = true;
+
+        return true;
+    }
+
+    private static getSmallTexture(asset: IGraphicAsset): Texture<Resource>
+    {
+        let texture = LoveHeartAddition.SMALL_TEXTURES.get(asset.name);
+
+        if(texture) return texture;
+
+        const source = asset.texture;
+
+        texture = TextureUtils.createAndWriteRenderTexture(Math.max(1, Math.ceil(source.width / 2)), Math.max(1, Math.ceil(source.height / 2)), new NitroSprite(source), new Matrix().scale(0.5, 0.5));
+
+        if(texture) LoveHeartAddition.SMALL_TEXTURES.set(asset.name, texture);
+
+        return (texture || source);
+    }
+
+    public get id(): number
+    {
+        return this._id;
+    }
+}
