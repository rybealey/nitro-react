+
+    LoadStats.unpackJobs += done;
+    LoadStats.unpackMs += (performance.now() - start);
+    LoadStats.unpackQueued = jobs.length;
+
+    NoteLoadWork(jobs.length > 0);
 
     if(jobs.length) schedule();
 }
@@ -64,5 +83,7 @@ export const UnpackSoon = <T>(work: () => T): Promise<T> => new Promise<T>((reso
