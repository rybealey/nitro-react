+++ b/src/api/utils/LoadBudget.ts
@@ -0,0 +1,88 @@
+// PixelRP: how much loading this computer takes per frame (Twist, 2026-10-28 -
+// "I want big rooms to load as fast as possible").
+//
+// A room arriving is three kinds of work, each spread over frames so a laptop
+// does not freeze: unpacking downloaded files (UnpackQueue, a turn at a time),
+// setting up the furni types they hold (RoomManager, a share a frame), and
+// sending their pictures to the graphics card (UploadGate, a share a frame).
+// Each share used to be fixed, sized for a laptop, so a fast PC sat filling a
+// big room in for half a second it did not need. Now all three are one SCALE,
+// learnt from what the frames do: at the start of each frame drawn to the
+// screen, if any of that work ran since the last one, the frame between is
+// judged. Its draw over SLOW_DRAW_MS, or the frame itself over SLOW_GAP_MS
+// long, halves the scale; twice those drops it to 1 at once (a computer that
+// slowed down, or a room far heavier than the last). A draw under FAST_DRAW_MS
+// and a frame under FAST_GAP_MS (on time at 60 Hz, where a missed refresh is
+// 33 ms) grows it by GROW - but only when some of the work had more to do than
+// its share let it; a few last pieces finishing quickly say nothing about how
+// much more the computer could take. A gap of HIDDEN_GAP_MS or more is the
+// page put away, and judges nothing. The scale is kept from room to room: a
+// fast PC learns once and takes the next room in a few frames, a laptop stays
+// at the share it can carry. Each kind of work takes the scale within its own
+// floor and ceiling (LoadScale).
+//
+// LoadStats is what a room's load did, for the staff lag recorder's room line.
+const LEAST_SCALE = 0.5;
+const MOST_SCALE = 16;
+const GROW = 1.5;
+const FAST_DRAW_MS = 10;
+const SLOW_DRAW_MS = 20;
+const FAST_GAP_MS = 25;
+const SLOW_GAP_MS = 60;
+const HIDDEN_GAP_MS = 1000;
+
+let scale = 1;
+let workSinceFrame = false;
+let limitedSinceFrame = false;
+let frameStartedAt = 0;
+let lastDrawMs = 0;
+
+export const LoadStats = {
+    // files unpacked (UnpackQueue jobs) and their time, since the page opened
+    unpackJobs: 0,
+    unpackMs: 0,
+    // jobs waiting to be unpacked now
+    unpackQueued: 0,
+    // furni types loaded and waiting to be set up (RoomManager), now
+    pendingTypes: 0,
+    // sheets the upload gate held back in the last frame drawn to the screen
+    heldBack: 0
+};
+
+/** This kind of work's share: the learnt scale, kept within least and most. */
+export const LoadScale = (least: number, most: number): number => Math.min(most, Math.max(least, scale));
+
+/** Some loading work ran - the next frame start judges what it did. Limited: it had more to do than its share. */
+export const NoteLoadWork = (limited: boolean = false): void =>
+{
+    workSinceFrame = true;
+
+    if(limited) limitedSinceFrame = true;
+}
+
+/** A frame drawn to the screen starts (UploadGate, the renderer's prerender). */
+export const LoadFrameStarted = (now: number): void =>
+{
+    if(workSinceFrame && frameStartedAt)
+    {
+        const gap = (now - frameStartedAt);
+
+        if(gap < HIDDEN_GAP_MS)
+        {
+            if((lastDrawMs > (SLOW_DRAW_MS * 2)) || (gap > (SLOW_GAP_MS * 2))) scale = Math.max(LEAST_SCALE, Math.min(1, (scale / 2)));
+            else if((lastDrawMs > SLOW_DRAW_MS) || (gap > SLOW_GAP_MS)) scale = Math.max(LEAST_SCALE, (scale / 2));
+            else if(limitedSinceFrame && (lastDrawMs < FAST_DRAW_MS) && (gap < FAST_GAP_MS)) scale = Math.min(MOST_SCALE, (scale * GROW));
+        }
+    }
+
+    workSinceFrame = false;
+    limitedSinceFrame = false;
+    frameStartedAt = now;
+    lastDrawMs = 0;
+}
+
+/** That frame's draw is done (the renderer's postrender): how long it took. */
+export const LoadFrameDrawn = (now: number): void =>
+{
+    if(frameStartedAt) lastDrawMs = (now - frameStartedAt);
+}
