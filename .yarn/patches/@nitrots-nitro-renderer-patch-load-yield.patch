+// PixelRP: when the player last moved or pressed the mouse, anywhere on the
+// page. Browsers that cannot say whether a click is waiting (Firefox, Safari)
+// place furniture in short turns while the mouse is busy - see
+// processPendingFurniture.
+let pixelrpPointerAt = -Infinity;
+
+if(typeof window !== 'undefined')
+{
+    const markPointer = () => (pixelrpPointerAt = performance.now());
+
+    window.addEventListener('pointermove', markPointer, { capture: true, passive: true });
+    window.addEventListener('pointerdown', markPointer, { capture: true, passive: true });
+}
