+    // PixelRP: how long one frame may spend placing a room's furniture while
+    // it fills in, and the shorter turn for a browser that cannot tell when a
+    // click is waiting, used while the mouse has moved in the last moment.
+    private static FURNITURE_FRAME_MS: number = 40;
+    private static FURNITURE_FRAME_MS_MOUSE_BUSY: number = 8;
+    private static MOUSE_BUSY_MS: number = 400;
+    // a waiting click ends a turn only after this much of it, so a held key -
+    // which keeps input waiting nearly all the time - cannot slow the room to
+    // a crawl
+    private static FURNITURE_FRAME_MIN_MS: number = 4;
+
+    // PixelRP: the browser says a click or a key press is waiting (Chrome and
+    // Edge; not mouse movement). Null where it cannot tell.
+    private static inputPending(): (() => boolean)
+    {
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        const scheduling = ((typeof navigator !== 'undefined') ? (navigator as any).scheduling : null);
+
+        if(!scheduling || (typeof scheduling.isInputPending !== 'function')) return null;
+
+        return () => scheduling.isInputPending();
+    }
