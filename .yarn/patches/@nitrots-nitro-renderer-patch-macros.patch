diff --git a/src/nitro/communication/messages/outgoing/RpSaveMacrosComposer.ts b/src/nitro/communication/messages/outgoing/RpSaveMacrosComposer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62f19ebdef57cad875071c365b450684ec54cc81
--- /dev/null
+++ b/src/nitro/communication/messages/outgoing/RpSaveMacrosComposer.ts
@@ -0,0 +1,24 @@
+import { IMessageComposer } from '../../../../api';
+
+// PixelRP: save the player's macros server-side, as one JSON document. The
+// emulator validates and re-serialises it before storing, so it is safe to
+// send the document straight from the Macros tab.
+export class RpSaveMacrosComposer implements IMessageComposer<ConstructorParameters<typeof RpSaveMacrosComposer>>
+{
+    private _data: ConstructorParameters<typeof RpSaveMacrosComposer>;
+
+    constructor(macros: string)
+    {
+        this._data = [macros];
+    }
+
+    public getMessageArray()
+    {
+        return this._data;
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
