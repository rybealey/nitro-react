diff --git a/src/nitro/communication/messages/incoming/RpMacrosEvent.ts b/src/nitro/communication/messages/incoming/RpMacrosEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67fc931ae96da2801105f6ba9e8458dd01cd1c42
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpMacrosEvent.ts
@@ -0,0 +1,46 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+// PixelRP: the player's saved macros, pushed by the server at login as one
+// JSON document (see the emulator's 62_Macros.sql for the shape). An empty
+// string means nothing has ever been saved - distinct from a saved-but-empty
+// document, so the client can tell a fresh account from a deliberately
+// cleared one and only seed defaults for the former.
+export class RpMacrosParser implements IMessageParser
+{
+    private _macros: string;
+
+    public flush(): boolean
+    {
+        this._macros = '';
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._macros = wrapper.readString();
+
+        return true;
+    }
+
+    public get macros(): string
+    {
+        return this._macros;
+    }
+}
+
+export class RpMacrosEvent extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpMacrosParser);
+    }
+
+    public getParser(): RpMacrosParser
+    {
+        return this.parser as RpMacrosParser;
+    }
+}
