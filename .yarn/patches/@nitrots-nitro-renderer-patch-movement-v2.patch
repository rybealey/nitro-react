+/**
+ * pixelrp Movement V2 - OPTION B SPIKE (client-local, experimental).
+ *
+ * THE HYPOTHESIS: we do not need a second renderer with a NATIVE / ARMED /
+ * AUTHORITATIVE ownership handoff. We need ONE interpolator whose phase comes
+ * from the server's absolute edge start instead of from packet arrival time.
+ *
+ * Stock Nitro interpolates as
+ *     phase = (tickerTime - _changeTime) / 500      // _changeTime = ARRIVAL
+ * (MovingObjectLogic.processMoveMessage sets _changeTime = _lastUpdateTime).
+ * Arrival jitter therefore becomes position jitter, and two avatars whose
+ * packets land 80ms apart can never be in lockstep. That single line is the
+ * entire reason the V1 authority layer exists.
+ *
+ * Option B changes ONLY the origin of that phase:
+ *     phase = (estimatedServerNow - edgeCycleStart) / interval
+ * and supplies geometry for future (lookahead) edges the native `mv` stream has
+ * not described yet. Everything else - posture, facing, depth sort, nametags,
+ * bubbles, hover, camera - keeps reading the room object's real location,
+ * because this writes through the SAME setLocation the engine already uses.
+ *
+ * ============================ CLOCK DOMAIN (B3) ============================
+ * VERIFIED in this tree, and this is the detail that decides the spike:
+ *   - object logic runs on GetTickerTime()  = PIXI Ticker.lastTime
+ *     (RoomEngine.update overwrites its argument with GetTickerTime() at :812)
+ *   - @pixi/ticker 6.5.10 sets `this.lastTime = performance.now()`
+ *   - the V1 authority instead sampled Date.now() (RoomSpriteCanvas.ts:560)
+ * Date.now() and performance.now() differ by performance.timeOrigin, so mixing
+ * them silently offsets every phase by hours.
+ *
+ * RESOLUTION: V2 uses performance.now() as its ONLY client clock. Packet
+ * arrival samples performance.now(), so the offset estimate is already in the
+ * ticker's domain and MovingObjectLogic needs no conversion at all.
+ */
+
+export interface PixelRPV2Edge
+{
+    session: number;
+    revision: number;
+    edgeIndex: number;
+    provisional: boolean;
+    sx: number; sy: number; sz: number;
+    gx: number; gy: number; gz: number;
+    /** Absolute SERVER tick at which this edge starts. */
+    cycleStart: number;
+    interval: number;
+}
+
+export interface PixelRPV2Active
+{
+    sx: number; sy: number; sz: number;
+    gx: number; gy: number; gz: number;
+    /** 0..1, clamped. */
+    phase: number;
+}
+
+interface PixelRPV2Unit
+{
+    id: number;
+    session: number;
+    revision: number;
+    edges: PixelRPV2Edge[];
+    lastPacketAtClient: number;
+}
+
+export class PixelRPMovementV2
+{
+    /** Drop a unit's timed state after this long with no packet -> native. */
+    private static readonly STALE_MS = 1400;
+    private static readonly MAX_EDGES = 8;
+
+    private static _instance: PixelRPMovementV2 = null;
+
+    public static get instance(): PixelRPMovementV2
+    {
+        if(!PixelRPMovementV2._instance) PixelRPMovementV2._instance = new PixelRPMovementV2();
+
+        return PixelRPMovementV2._instance;
+    }
+
+    private readonly _units = new Map<number, PixelRPV2Unit>();
+
+    /** performance.now() - serverNow, min-filtered. NaN until the first packet. */
+    private _clockOffset = NaN;
+    private _windowStart = 0;
+    private _windowMin = NaN;
+
+    /** Spike instrumentation only. */
+    public stats = { edges: 0, corrections: 0, starvations: 0, staleDrops: 0, displacements: 0 };
+
+    public get hasClock(): boolean { return Number.isFinite(this._clockOffset); }
+
+    public get clockOffset(): number { return this._clockOffset; }
+
+    /**
+     * One connection-wide offset: the MINIMUM observed (clientNow - serverNow)
+     * over a rolling window, i.e. the fastest packet. Per-packet latency must
+     * never become a per-avatar phase origin.
+     */
+    public updateClock(clientNowPerf: number, serverNow: number): void
+    {
+        const sample = (clientNowPerf - serverNow);
+
+        if(!Number.isFinite(this._clockOffset) || (Math.abs(sample - this._clockOffset) > 5000))
+        {
+            this._clockOffset = sample;
+            this._windowStart = clientNowPerf;
+            this._windowMin = sample;
+
+            return;
+        }
+
+        if(sample < this._clockOffset) this._clockOffset = sample;
+
+        this._windowMin = Number.isFinite(this._windowMin) ? Math.min(this._windowMin, sample) : sample;
+
+        if((clientNowPerf - this._windowStart) > 30000)
+        {
+            if(Number.isFinite(this._windowMin)) this._clockOffset = this._windowMin;
+
+            this._windowStart = clientNowPerf;
+            this._windowMin = NaN;
+        }
+    }
+
+    /**
+     * Record one real edge plus its provisional lookahead.
+     *
+     * Ordering is the locked total order (session, revision, edgeIndex): an
+     * older tuple can never affect newer movement, and a higher revision
+     * replaces geometry ONLY for indexes strictly greater than the elapsing one
+     * (the server guarantees it never restages an elapsed index).
+     */
+    public recordEdge(
+        virtualId: number,
+        session: number,
+        revision: number,
+        edgeIndex: number,
+        sx: number, sy: number, sz: number,
+        gx: number, gy: number, gz: number,
+        cycleStart: number,
+        interval: number,
+        serverNow: number,
+        clientNowPerf: number,
+        lookahead: { x: number, y: number, z: number }[] = []): void
+    {
+        this.updateClock(clientNowPerf, serverNow);
+
+        let unit = this._units.get(virtualId);
+
+        if(!unit)
+        {
+            unit = { id: virtualId, session, revision, edges: [], lastPacketAtClient: clientNowPerf };
+
+            this._units.set(virtualId, unit);
+        }
+
+        // Newer session wipes the queue; older is dropped outright.
+        if(session > unit.session)
+        {
+            unit.session = session;
+            unit.revision = revision;
+            unit.edges = [];
+        }
+        else if(session < unit.session)
+        {
+            return;
+        }
+        else if(revision > unit.revision)
+        {
+            // A correction: drop provisional geometry at or after this index.
+            unit.revision = revision;
+            unit.edges = unit.edges.filter(e => (e.edgeIndex < edgeIndex));
+            this.stats.corrections++;
+        }
+        else if(revision < unit.revision)
+        {
+            return;
+        }
+
+        unit.lastPacketAtClient = clientNowPerf;
+
+        const step = ((interval > 0) ? interval : 500);
+
+        this.upsert(unit, {
+            session, revision, edgeIndex, provisional: false,
+            sx, sy, sz, gx, gy, gz, cycleStart, interval: step
+        });
+        this.stats.edges++;
+
+        // Lookahead: a contiguous chain. from = previous goal, start = previous
+        // end. This is what removes boundary packet-waiting.
+        let prev: PixelRPV2Edge = { session, revision, edgeIndex, provisional: false, sx, sy, sz, gx, gy, gz, cycleStart, interval: step };
+
+        for(let i = 0; i < lookahead.length; i++)
+        {
+            const look = lookahead[i];
+            const edge: PixelRPV2Edge = {
+                session, revision,
+                edgeIndex: (edgeIndex + i + 1),
+                provisional: true,
+                sx: prev.gx, sy: prev.gy, sz: prev.gz,
+                gx: look.x, gy: look.y, gz: look.z,
+                cycleStart: (prev.cycleStart + prev.interval),
+                interval: step
+            };
+
+            this.upsert(unit, edge);
+            prev = edge;
+        }
+
+        unit.edges.sort((a, b) => (a.edgeIndex - b.edgeIndex));
+
+        if(unit.edges.length > PixelRPMovementV2.MAX_EDGES)
+        {
+            unit.edges.splice(0, (unit.edges.length - PixelRPMovementV2.MAX_EDGES));
+        }
+    }
+
+    private upsert(unit: PixelRPV2Unit, edge: PixelRPV2Edge): void
+    {
+        const index = unit.edges.findIndex(e => (e.edgeIndex === edge.edgeIndex));
+
+        if(index >= 0)
+        {
+            // A confirmed real edge always beats a provisional guess.
+            if(unit.edges[index].provisional || !edge.provisional) unit.edges[index] = edge;
+
+            return;
+        }
+
+        unit.edges.push(edge);
+    }
+
+    /** Teleport / roller / forced move: drop timed state, hand back to native. */
+    public displace(virtualId: number): void
+    {
+        this.stats.displacements++;
+        this._units.delete(virtualId);
+    }
+
+    public forget(virtualId: number): void
+    {
+        this._units.delete(virtualId);
+    }
+
+    /**
+     * THE render-path query. `tickerNow` MUST be GetTickerTime()/performance.now().
+     *
+     * Returns the edge covering the estimated server time, with its clamped
+     * phase, or null when native should own the frame (no clock, no timed edge,
+     * stale, or past the last known edge).
+     *
+     * Starvation is INHERENT here: past the last edge the phase clamps at 1.0,
+     * so the avatar holds at the real terminal tile. It never speeds up and
+     * never skips - there is no catch-up path to write.
+     */
+    public getActive(virtualId: number, tickerNow: number): PixelRPV2Active
+    {
+        if(!Number.isFinite(this._clockOffset)) return null;
+
+        const unit = this._units.get(virtualId);
+
+        if(!unit || !unit.edges.length) return null;
+
+        if((tickerNow - unit.lastPacketAtClient) > PixelRPMovementV2.STALE_MS)
+        {
+            this.stats.staleDrops++;
+            this._units.delete(virtualId);
+
+            return null;
+        }
+
+        const estServerNow = (tickerNow - this._clockOffset);
+
+        let edge: PixelRPV2Edge = null;
+
+        for(let i = (unit.edges.length - 1); i >= 0; i--)
+        {
+            if(unit.edges[i].cycleStart <= estServerNow) { edge = unit.edges[i]; break; }
+        }
+
+        if(!edge) return null;
+
+        const raw = ((estServerNow - edge.cycleStart) / edge.interval);
+
+        if(raw > 1) this.stats.starvations++;
+
+        const phase = Math.min(1, Math.max(0, raw));
+
+        return {
+            sx: edge.sx, sy: edge.sy, sz: edge.sz,
+            gx: edge.gx, gy: edge.gy, gz: edge.gz,
+            phase
+        };
+    }
+}
