diff --git a/src/nitro/communication/messages/incoming/RpMovementV2Event.ts b/src/nitro/communication/messages/incoming/RpMovementV2Event.ts
new file mode 100644
index 0000000..517d47b
--- /dev/null
+++ b/src/nitro/communication/messages/incoming/RpMovementV2Event.ts
@@ -0,0 +1,135 @@
+import { IMessageDataWrapper, IMessageEvent, IMessageParser } from '../../../../api';
+import { MessageEvent } from '../../../../events';
+
+/**
+ * pixelrp Movement V2 - packet 4110 (SPIKE parser).
+ *
+ * 4110 is the LOCKED V2 movement identity. Packet 3955 is V1-only, is retired
+ * at cutover, and is NEVER reused: a V1 client fed a V2 payload on 3955 would
+ * not reject it, it would parse field 0 as virtualId and drive a fabricated
+ * avatar. A brand new header is the only fail-safe option, because an
+ * unregistered header is a silent no-op on the client
+ * (SocketConnection.getMessagesForWrapper logs UNREGISTERED and returns).
+ *
+ * Field order is the locked layout; formatVersion is field 0 so a V2-vs-V2
+ * skew is discarded whole rather than mis-parsed.
+ */
+export class RpMovementV2Parser implements IMessageParser
+{
+    public static readonly FORMAT_VERSION = 2;
+
+    private _ok: boolean;
+    private _formatVersion: number;
+    private _virtualId: number;
+    private _flags: number;
+    private _walkSessionId: number;
+    private _routeRevision: number;
+    private _edgeIndex: number;
+    private _timingGroupId: number;
+    private _intervalMs: number;
+    private _cycleStart: number;
+    private _serverNow: number;
+    private _fromX: number;
+    private _fromY: number;
+    private _fromZ: number;
+    private _toX: number;
+    private _toY: number;
+    private _toZ: number;
+    private _lookahead: { x: number, y: number, z: number }[];
+
+    public flush(): boolean
+    {
+        this._ok = false;
+        this._virtualId = -1;
+        this._lookahead = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._formatVersion = wrapper.readInt();
+
+        // Unknown version: discard the packet WHOLE. Never partially parse -
+        // that is the failure mode reusing 3955 would have had.
+        if(this._formatVersion !== RpMovementV2Parser.FORMAT_VERSION)
+        {
+            this._ok = false;
+
+            return true;
+        }
+
+        this._virtualId = wrapper.readInt();
+        this._flags = wrapper.readInt();
+        this._walkSessionId = wrapper.readInt();
+        this._routeRevision = wrapper.readInt();
+        this._edgeIndex = wrapper.readInt();
+        this._timingGroupId = wrapper.readInt();
+        this._intervalMs = wrapper.readInt();
+
+        const cycleStartDelta = wrapper.readInt();
+        const serverNowHi = wrapper.readInt();
+        const serverNowLo = (wrapper.readInt() >>> 0);
+
+        this._serverNow = ((serverNowHi * 4294967296) + serverNowLo);
+        this._cycleStart = (this._serverNow + cycleStartDelta);
+
+        this._fromX = wrapper.readInt();
+        this._fromY = wrapper.readInt();
+        this._fromZ = (wrapper.readInt() / 100);
+        this._toX = wrapper.readInt();
+        this._toY = wrapper.readInt();
+        this._toZ = (wrapper.readInt() / 100);
+
+        const lookCount = wrapper.readInt();
+
+        for(let i = 0; i < Math.min(3, lookCount); i++)
+        {
+            this._lookahead.push({ x: wrapper.readInt(), y: wrapper.readInt(), z: (wrapper.readInt() / 100) });
+        }
+
+        this._ok = true;
+
+        return true;
+    }
+
+    public get ok(): boolean { return this._ok; }
+    public get formatVersion(): number { return this._formatVersion; }
+    public get virtualId(): number { return this._virtualId; }
+    public get flags(): number { return this._flags; }
+    public get walkSessionId(): number { return this._walkSessionId; }
+    public get routeRevision(): number { return this._routeRevision; }
+    public get edgeIndex(): number { return this._edgeIndex; }
+    public get timingGroupId(): number { return this._timingGroupId; }
+    public get intervalMs(): number { return this._intervalMs; }
+    public get cycleStart(): number { return this._cycleStart; }
+    public get serverNow(): number { return this._serverNow; }
+    public get fromX(): number { return this._fromX; }
+    public get fromY(): number { return this._fromY; }
+    public get fromZ(): number { return this._fromZ; }
+    public get toX(): number { return this._toX; }
+    public get toY(): number { return this._toY; }
+    public get toZ(): number { return this._toZ; }
+    public get lookahead(): { x: number, y: number, z: number }[] { return (this._lookahead || []); }
+
+    /** flags bit 0x0004 - teleport / roller / forced move. */
+    public get isDisplacement(): boolean { return (this._flags & 0x0004) !== 0; }
+
+    /** flags bit 0x0002 - this walk session is over. */
+    public get isWalkEnd(): boolean { return (this._flags & 0x0002) !== 0; }
+}
+
+export class RpMovementV2Event extends MessageEvent implements IMessageEvent
+{
+    constructor(callBack: Function)
+    {
+        super(callBack, RpMovementV2Parser);
+    }
+
+    public getParser(): RpMovementV2Parser
+    {
+        return this.parser as RpMovementV2Parser;
+    }
+}
