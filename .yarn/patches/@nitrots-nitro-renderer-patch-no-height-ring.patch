@@ -3,6 +3,10 @@ import { FurnitureAnimatedVisualization } from '../furniture';
 
 export class TileCursorVisualization extends FurnitureAnimatedVisualization
 {
+    // PixelRP: TileCursorLogic's raised "height" state - over a furni you can
+    // stand, sit or lie on whose top is above 0.8.
+    private static HEIGHT_STATE: number = 6;
+
     private _tileHeight: number;
 
     constructor()
@@ -23,4 +27,22 @@ export class TileCursorVisualization extends FurnitureAnimatedVisualization
 
         return super.getLayerYOffset(scale, direction, layerId);
     }
+
+    // PixelRP: no blue ring. In the height state layer 1 floats at the
+    // surface height (getLayerYOffset above) and draws a small blue ring,
+    // while layer 0 - the white diamond - stays on the floor of the tile,
+    // below the mouse. Here layer 1 draws the white diamond instead (layer 0's
+    // own frame) and the floor copy is hidden, so the one normal cursor sits
+    // on the furni's top, under the mouse.
+    protected getSpriteAssetName(scale: number, layerId: number): string
+    {
+        if(this.object && (this.object.getState(0) === TileCursorVisualization.HEIGHT_STATE))
+        {
+            if(layerId === 0) return '';
+
+            if(layerId === 1) return super.getSpriteAssetName(scale, 0);
+        }
+
+        return super.getSpriteAssetName(scale, layerId);
+    }
 }
