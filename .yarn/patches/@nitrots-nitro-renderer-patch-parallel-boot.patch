@@ -27,6 +29,20 @@
 
         this._pendingUrls = NitroConfiguration.getValue<string[]>('config.urls').slice();
 
+        // PixelRP: every file is asked for at once, and still parsed one after
+        // another in the listed order (a later file overrides an earlier one).
+        // Fetched one after another, each cost a round trip before the next.
+        for(const url of this._pendingUrls)
+        {
+            if(!url || this._prefetched.has(url)) continue;
+
+            const data = fetch(url).then(response => response.json());
+
+            data.catch(() => null);
+
+            this._prefetched.set(url, data);
+        }
+
         this.loadNextConfiguration();
     }
 
@@ -51,8 +67,11 @@
             return;
         }
 
-        fetch(url)
-            .then(response => response.json())
+        const prefetched = this._prefetched.get(url);
+
+        this._prefetched.delete(url);
+
+        (prefetched || fetch(url).then(response => response.json()))
             .then(data => this.onConfigurationLoaded(data, url))
             .catch(err => this.onConfigurationFailed(err));
     }
