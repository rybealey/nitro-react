+    /**
+     * PixelRP: a furni type's file is asked for as soon as a piece of it is
+     * queued for the room, not when that piece's turn to be placed comes
+     * round (RoomManager.createRoomObjectAndInitalize). A room's furni are
+     * placed 40ms a frame, so in a big room a file the browser does not have
+     * started downloading hundreds of ms after the room arrived; now they all
+     * set off with the list. The same type name the placement uses, so the
+     * same file: downloadAsset skips one that is here or on its way, and the
+     * placeholder of a piece placed before its file lands is swapped when it
+     * does, as for the city's furni (the client's RpCityFurniPreload).
+     */
+    private pixelrpDownloadFurniture(type: string): void
+    {
+        const loader = this._roomContentLoader;
+
+        if(!type || !loader || !this._roomManager || !loader.isLoaderType(type) || loader.getCollection(type)) return;
+
+        loader.downloadAsset(type, this._roomManager.events);
     }
 
