+
+    /**
+     * PixelRP: the server moved the player straight from one room into the
+     * next (an arrow, a booth, :follow). The old room is destroyed as the new
+     * one arrives, but the new one draws nothing at first - its floor and
+     * walls are built on its second update and its pictures reach the
+     * graphics card on the third - so every trip showed a black frame, then
+     * furniture popping in. The screen as it is now is copied (on the
+     * graphics card, nothing read back) and laid over everything until the
+     * new room is drawn with all of its furniture placed, or for a second at
+     * most (pixelrpUpdateHeldRoomPicture). Clicks are not held back: they
+     * reach the new room underneath.
+     */
+    public pixelrpHoldRoomPicture(fromRoomId: number, toRoomId: number): void
+    {
+        const stage = (PixiApplicationProxy.instance && PixiApplicationProxy.instance.stage);
+
+        if(!stage || !stage.children.length || !this.getRoomInstance(fromRoomId)) return;
+
+        // never in the way of the room change itself: anything going wrong
+        // here only means no picture, as before
+        try
+        {
+            const renderer = TextureUtils.getRenderer();
+            const texture = TextureUtils.createAndWriteRenderTexture(renderer.screen.width, renderer.screen.height, stage);
+
+            // a trip straight after another: the new copy already shows the
+            // previous one, which can go
+            this.pixelrpReleaseRoomPicture();
+
+            if(!texture) return;
+
+            const sprite = new NitroSprite(texture);
+
+            stage.addChild(sprite);
+
+            this._pixelrpHeldPicture = { sprite, roomId: toRoomId, startedAt: performance.now(), updates: 0, placed: false, readyUpdates: 0 };
