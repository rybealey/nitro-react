diff --git a/src/nitro/room/object/visualization/avatar/additions/SocialEffectAddition.ts b/src/nitro/room/object/visualization/avatar/additions/SocialEffectAddition.ts
new file mode 100644
index 0000000..b48ea5f
--- /dev/null
+++ b/src/nitro/room/object/visualization/avatar/additions/SocialEffectAddition.ts
@@ -0,0 +1,157 @@
+import { BLEND_MODES } from '@pixi/constants';
+import { Resource, Texture } from '@pixi/core';
+import { Matrix } from '@pixi/math';
+import { IGraphicAsset, IRoomObjectSprite } from '../../../../../../api';
+import { GetTickerTime, NitroSprite, TextureUtils } from '../../../../../../pixi-proxy';
+import { AvatarVisualization } from '../AvatarVisualization';
+import { IAvatarAddition } from './IAvatarAddition';
+
+/** One of an effect's sprites: where it starts in the loop, and how far it sits from the first. */
+interface ISocialEffectTrack
+{
+    start: number;
+    dx: number;
+    dy: number;
+}
+
+interface ISocialEffect
+{
+    // The asset member, as in h_<member>_0_<frame>.
+    member: string;
+    frames: number;
+    // Milliseconds per frame.
+    frameLength: number;
+    blendMode: number;
+    // 0-255, as IRoomObjectSprite.alpha.
+    alpha: number;
+    tracks: ISocialEffectTrack[];
+}
+
+/**
+ * pixelrp: one sprite of the effect floated over both people in a social
+ * command - :kiss, :bite and :hug (SocialCommand.OverlayExpression on the emulator).
+ *
+ * The effect is drawn as additions instead of worn. An avatar wears one
+ * effect at a time, and the handcuffs, the stun's birds, the ambulance and the
+ * staff and passive markers are all effects - wearing these would take them
+ * off for two seconds. Additions sit beside the effect the way the typing
+ * bubble and the sleeping Zzz do; one addition per sprite of the effect.
+ *
+ * The art and its offsets come from the effect's own library, and each sprite
+ * is placed with the formula AvatarVisualization uses for an effect's
+ * sprites, so it lands where Habbo draws it. Both effects only ship the large
+ * size; zoomed out, each frame is drawn at half size from it.
+ */
+export class SocialEffectAddition implements IAvatarAddition
+{
+    // One avatar animation frame - Habbo's speed. AvatarVisualization updates every
+    // 41ms but moves an effect on only every second update (ANIMATION_FRAME_UPDATE_INTERVAL).
+    private static FRAME_LENGTH: number = 82;
+
+    // Effect id -> what to draw. The sprite tables are copied from each
+    // effect's animation in its library (nitro/assets/bundled/effect).
+    public static EFFECTS: Map<number, ISocialEffect> = new Map([
+        // Love: three small hearts floating up, at Habbo's speed. Ink 33,
+        // which an effect draws additively - what lightens them against dark
+        // hair and walls.
+        [ 9, { member: 'std_fx9_1_1', frames: 21, frameLength: SocialEffectAddition.FRAME_LENGTH, blendMode: BLEND_MODES.ADD, alpha: 255, tracks: [ { start: 0, dx: 0, dy: 0 }, { start: 10, dx: 10, dy: -3 }, { start: 14, dx: 18, dy: 2 } ] } ],
+        // Spinning Hearts: one picture of the whole ring of hearts per frame.
+        // A turn every 1.5 seconds against Habbo's 1, and 90% seen, so the
+        // big hearts sit over the hug instead of covering it.
+        [ 168, { member: 'std_fx168_1_1', frames: 12, frameLength: 125, blendMode: BLEND_MODES.NORMAL, alpha: 230, tracks: [ { start: 0, dx: 0, dy: 0 } ] } ]
+    ]);
+    private static SMALL_TEXTURES: Map<string, Texture<Resource>> = new Map();
+
+    private _id: number;
+    private _effectId: number;
+    private _effect: ISocialEffect;
+    private _track: ISocialEffectTrack;
+    private _visualization: AvatarVisualization;
+    private _startTime: number;
+    private _scale: number;
+    private _requested: boolean;
+
+    constructor(id: number, effectId: number, track: number, visualization: AvatarVisualization)
+    {
+        this._id = id;
+        this._effectId = effectId;
+        this._effect = SocialEffectAddition.EFFECTS.get(effectId);
+        this._track = this._effect.tracks[track];
+        this._visualization = visualization;
+        this._startTime = GetTickerTime();
+        this._scale = 64;
+        this._requested = false;
+    }
+
+    public dispose(): void
+    {
+        this._visualization = null;
+    }
+
+    public update(sprite: IRoomObjectSprite, scale: number): void
+    {
+        if(!sprite) return;
+
+        this._scale = scale;
+
+        this.animate(sprite);
+    }
+
+    public animate(sprite: IRoomObjectSprite): boolean
+    {
+        if(!sprite || !this._visualization) return false;
+
+        const frame = ((this._track.start + Math.floor((GetTickerTime() - this._startTime) / this._effect.frameLength)) % this._effect.frames);
+        const asset = this._visualization.getAvatarRenderGraphicAsset('h_' + this._effect.member + '_0_' + frame);
+
+        if(!asset || !asset.texture)
+        {
+            // Nobody has worn the effect yet this session, so its library was
+            // never fetched. Ask once; it appears as soon as it lands.
+            if(!this._requested)
+            {
+                this._requested = true;
+
+                this._visualization.downloadAvatarEffect(this._effectId);
+            }
+
+            sprite.visible = false;
+
+            return false;
+        }
+
+        const half = ((this._scale < 48) ? 0.5 : 1);
+
+        sprite.texture = ((half < 1) ? SocialEffectAddition.getSmallTexture(asset) : asset.texture);
+        sprite.offsetX = (((asset.offsetX + this._track.dx) * half) - (this._scale / 2));
+        sprite.offsetY = (((asset.offsetY + this._track.dy) * half) + this._visualization.postureOffset);
+        sprite.flipH = asset.flipH;
+        // AvatarVisualization puts every addition back to NORMAL before it is handed a sprite.
+        sprite.blendMode = this._effect.blendMode;
+        sprite.alpha = this._effect.alpha;
+        sprite.relativeDepth = -0.02;
+        sprite.visible = true;
+
+        return true;
+    }
+
+    private static getSmallTexture(asset: IGraphicAsset): Texture<Resource>
+    {
+        let texture = SocialEffectAddition.SMALL_TEXTURES.get(asset.name);
+
+        if(texture) return texture;
+
+        const source = asset.texture;
+
+        texture = TextureUtils.createAndWriteRenderTexture(Math.max(1, Math.ceil(source.width / 2)), Math.max(1, Math.ceil(source.height / 2)), new NitroSprite(source), new Matrix().scale(0.5, 0.5));
+
+        if(texture) SocialEffectAddition.SMALL_TEXTURES.set(asset.name, texture);
+
+        return (texture || source);
+    }
+
+    public get id(): number
+    {
+        return this._id;
+    }
+}
