diff --git a/src/nitro/room/object/visualization/avatar/TargetOutlineFilter.ts b/src/nitro/room/object/visualization/avatar/TargetOutlineFilter.ts
new file mode 100644
index 0000000..6f7e8b8
--- /dev/null
+++ b/src/nitro/room/object/visualization/avatar/TargetOutlineFilter.ts
@@ -0,0 +1,111 @@
+import { Filter } from '@pixi/core';
+
+// pixelrp: the line round your locked target, or its tint (Settings > UI >
+// Target select; boards A-C and E of the "Target Lock Highlight" canvas). A
+// pixel joins the line when a solid pixel of the avatar is within `line`
+// pixels of it in any direction, diagonals too, so the line keeps the
+// sprite's pixel-art steps; Glow adds a soft fade for a few pixels past it;
+// Tint mixes the player's colour into the avatar itself. It is drawn on the
+// avatar's own sprite, so furni in front of the avatar hides it with them.
+
+// The design system's danger red, the canvas's default.
+export const TARGET_DEFAULT_COLOUR = 0xE03131;
+
+// inputSize is highp, as Pixi's filter vertex shader has it: a uniform that
+// both shaders declare must match in precision, or the program will not link
+// and the avatar is not drawn at all.
+const fragment = (reach: number) => `
+varying vec2 vTextureCoord;
+uniform sampler2D uSampler;
+uniform highp vec4 inputSize;
+uniform highp vec4 inputClamp;
+uniform vec3 uColor;
+uniform float uLine;
+uniform float uGlow;
+uniform float uTint;
+
+const int REACH = ${ reach };
+
+void main(void)
+{
+    vec4 own = texture2D(uSampler, vTextureCoord);
+
+    own = vec4(mix(own.rgb, (uColor * own.a), uTint), own.a);
+
+    if((own.a >= 1.0) || (REACH == 0))
+    {
+        gl_FragColor = own;
+        return;
+    }
+
+    float line = 0.0;
+    float glow = 0.0;
+
+    for(int y = -REACH; y <= REACH; y++)
+    {
+        for(int x = -REACH; x <= REACH; x++)
+        {
+            vec2 offset = vec2(float(x), float(y));
+            float away = max(abs(offset.x), abs(offset.y));
+
+            if(away < 1.0) continue;
+
+            vec2 at = clamp((vTextureCoord + (offset * inputSize.zw)), inputClamp.xy, inputClamp.zw);
+
+            if(texture2D(uSampler, at).a < 0.5) continue;
+
+            if(away <= uLine) line = 1.0;
+            else glow = max(glow, ((1.0 - ((length(offset) - uLine) / (uGlow + 1.0))) * 0.6));
+        }
+    }
+
+    float edge = max(line, glow);
+
+    gl_FragColor = (own + (vec4((uColor * edge), edge) * (1.0 - own.a)));
+}`;
+
+// Each style's line, glow and tint.
+const STYLES: Record<string, [ number, number, number ]> = {
+    thin: [ 1, 0, 0 ],
+    thick: [ 2, 0, 0 ],
+    glow: [ 1, 4, 0 ],
+    linering: [ 1, 0, 0 ],
+    tint: [ 0, 0, 0.45 ]
+};
+
+export class TargetOutlineFilter extends Filter
+{
+    private static NONE: Filter[] = [];
+    private static _made: Map<string, Filter[]> = new Map();
+
+    constructor(line: number, glow: number, tint: number, colour: number)
+    {
+        const rgb = new Float32Array([ (((colour >> 16) & 0xFF) / 255), (((colour >> 8) & 0xFF) / 255), ((colour & 0xFF) / 255) ]);
+
+        super(undefined, fragment(line + glow), { uColor: rgb, uLine: line, uGlow: glow, uTint: tint });
+
+        this.padding = (line + glow);
+    }
+
+    /** The filters for a style in a colour, made once and shared; none for a style drawn some other way. */
+    public static filtersFor(style: string, colour: number): Filter[]
+    {
+        const shape = STYLES[style];
+
+        if(!shape) return TargetOutlineFilter.NONE;
+
+        const key = `${ style }:${ colour }`;
+        const existing = TargetOutlineFilter._made.get(key);
+
+        if(existing) return existing;
+
+        // Only the player's own choice is ever drawn, so a few are plenty.
+        if(TargetOutlineFilter._made.size >= 16) TargetOutlineFilter._made.clear();
+
+        const filters = [ new TargetOutlineFilter(shape[0], shape[1], shape[2], colour) ];
+
+        TargetOutlineFilter._made.set(key, filters);
+
+        return filters;
+    }
+}
diff --git a/src/nitro/room/object/visualization/avatar/additions/TargetArrowAddition.ts b/src/nitro/room/object/visualization/avatar/additions/TargetArrowAddition.ts
new file mode 100644
index 0000000..3cf4c36
--- /dev/null
+++ b/src/nitro/room/object/visualization/avatar/additions/TargetArrowAddition.ts
@@ -0,0 +1,134 @@
+import { SCALE_MODES } from '@pixi/constants';
+import { BaseTexture, Resource, Texture } from '@pixi/core';
+import { AvatarAction, IRoomObjectSprite } from '../../../../../../api';
+import { AvatarVisualization } from '../AvatarVisualization';
+import { IAvatarAddition } from './IAvatarAddition';
+
+// pixelrp: the arrow over your locked target's head (Settings > UI > Target
+// select): a small pixel arrow in the player's colour, pointing down at them,
+// with a darker edge so it reads over a light floor or a dark wall. It floats
+// where the muted and typing bubbles do, and follows the avatar sitting or
+// lying down the same way.
+
+// Each row of the arrow at full size, from the top: the stem, then the head.
+// 'o' is the edge, 'x' the colour.
+const LARGE = [
+    '   ooooo   ',
+    '   oxxxo   ',
+    '   oxxxo   ',
+    'oooxxxxxooo',
+    ' oxxxxxxxo ',
+    '  oxxxxxo  ',
+    '   oxxxo   ',
+    '    oxo    ',
+    '     o     '
+];
+
+const SMALL = [
+    ' ooo ',
+    'ooxoo',
+    ' oxo ',
+    '  o  '
+];
+
+export class TargetArrowAddition implements IAvatarAddition
+{
+    // One texture per size and colour, drawn once.
+    private static _textures: Map<string, Texture<Resource>> = new Map();
+
+    private _id: number;
+    private _visualization: AvatarVisualization;
+    private _colour: number;
+    private _asset: Texture<Resource>;
+
+    constructor(id: number, visualization: AvatarVisualization, colour: number)
+    {
+        this._id = id;
+        this._visualization = visualization;
+        this._colour = colour;
+        this._asset = null;
+    }
+
+    private static arrowTexture(rows: string[], colour: number): Texture<Resource>
+    {
+        const key = `${ rows.length }:${ colour }`;
+        const existing = TargetArrowAddition._textures.get(key);
+
+        if(existing) return existing;
+
+        const width = rows[0].length;
+        const height = rows.length;
+        const pixels = new Uint8Array(width * height * 4);
+        const r = ((colour >> 16) & 0xFF);
+        const g = ((colour >> 8) & 0xFF);
+        const b = (colour & 0xFF);
+
+        for(let y = 0; y < height; y++)
+        {
+            for(let x = 0; x < width; x++)
+            {
+                const cell = rows[y][x];
+
+                if(cell === ' ') continue;
+
+                // The edge is the colour at 45% - dark enough to outline it on
+                // a light floor, still plainly the same colour.
+                const shade = ((cell === 'o') ? 0.45 : 1);
+                const at = (((y * width) + x) * 4);
+
+                pixels[at] = Math.round(r * shade);
+                pixels[at + 1] = Math.round(g * shade);
+                pixels[at + 2] = Math.round(b * shade);
+                pixels[at + 3] = 255;
+            }
+        }
+
+        if(TargetArrowAddition._textures.size >= 16) TargetArrowAddition._textures.clear();
+
+        const texture = new Texture(BaseTexture.fromBuffer(pixels, width, height, { scaleMode: SCALE_MODES.NEAREST }));
+
+        TargetArrowAddition._textures.set(key, texture);
+
+        return texture;
+    }
+
+    public dispose(): void
+    {
+        this._visualization = null;
+        this._asset = null;
+    }
+
+    public update(sprite: IRoomObjectSprite, scale: number): void
+    {
+        if(!sprite) return;
+
+        const small = (scale < 48);
+        const rows = (small ? SMALL : LARGE);
+        // Its point just over the top of the head.
+        let offsetY = ((small ? -50 : -95) - rows.length);
+
+        if(this._visualization.posture === AvatarAction.POSTURE_SIT) offsetY += ((small ? 32 : 64) / 2);
+        else if(this._visualization.posture === AvatarAction.POSTURE_LAY) offsetY += scale;
+
+        this._asset = TargetArrowAddition.arrowTexture(rows, this._colour);
+
+        sprite.visible = true;
+        sprite.texture = this._asset;
+        sprite.offsetX = -Math.floor(rows[0].length / 2);
+        sprite.offsetY = offsetY;
+        sprite.alpha = 255;
+        sprite.relativeDepth = -0.02;
+    }
+
+    public animate(sprite: IRoomObjectSprite): boolean
+    {
+        if(this._asset && sprite) sprite.texture = this._asset;
+
+        return false;
+    }
+
+    public get id(): number
+    {
+        return this._id;
+    }
+}
diff --git a/src/nitro/room/object/visualization/avatar/additions/TargetRingAddition.ts b/src/nitro/room/object/visualization/avatar/additions/TargetRingAddition.ts
new file mode 100644
index 0000000..1412859
--- /dev/null
+++ b/src/nitro/room/object/visualization/avatar/additions/TargetRingAddition.ts
@@ -0,0 +1,112 @@
+import { SCALE_MODES } from '@pixi/constants';
+import { BaseTexture, Resource, Texture } from '@pixi/core';
+import { AvatarAction, IRoomObjectSprite } from '../../../../../../api';
+import { AvatarVisualization } from '../AvatarVisualization';
+import { IAvatarAddition } from './IAvatarAddition';
+
+// pixelrp: the ring on the floor round your locked target's feet (Settings >
+// UI > Target select, boards D and E of the "Target Lock Highlight" canvas): a
+// one-pixel ellipse in the player's colour, flat on the tile, over a faint
+// fill of it. It sits where the avatar's shadow does, just in front of it and
+// behind the avatar, so furni in front of the avatar hides it too.
+
+const FILL_ALPHA = 56;
+
+export class TargetRingAddition implements IAvatarAddition
+{
+    // One texture per room scale and colour, drawn once.
+    private static _textures: Map<string, Texture<Resource>> = new Map();
+
+    private _id: number;
+    private _visualization: AvatarVisualization;
+    private _colour: number;
+    private _asset: Texture<Resource>;
+
+    constructor(id: number, visualization: AvatarVisualization, colour: number)
+    {
+        this._id = id;
+        this._visualization = visualization;
+        this._colour = colour;
+        this._asset = null;
+    }
+
+    // Half its width and height in pixels: two to one, as a floor tile is.
+    private static ringTexture(radius: number, colour: number): Texture<Resource>
+    {
+        const key = `${ radius }:${ colour }`;
+        const existing = TargetRingAddition._textures.get(key);
+
+        if(existing) return existing;
+
+        const rx = radius;
+        const ry = Math.round(radius / 2);
+        const width = ((rx * 2) + 1);
+        const height = ((ry * 2) + 1);
+        const inside = (x: number, y: number) => ((x >= 0) && (y >= 0) && (x < width) && (y < height) && ((((x - rx) / (rx + 0.5)) ** 2) + (((y - ry) / (ry + 0.5)) ** 2) <= 1));
+        const pixels = new Uint8Array(width * height * 4);
+
+        for(let y = 0; y < height; y++)
+        {
+            for(let x = 0; x < width; x++)
+            {
+                if(!inside(x, y)) continue;
+
+                const edge = (!inside((x - 1), y) || !inside((x + 1), y) || !inside(x, (y - 1)) || !inside(x, (y + 1)));
+                const at = (((y * width) + x) * 4);
+
+                pixels[at] = ((colour >> 16) & 0xFF);
+                pixels[at + 1] = ((colour >> 8) & 0xFF);
+                pixels[at + 2] = (colour & 0xFF);
+                pixels[at + 3] = (edge ? 255 : FILL_ALPHA);
+            }
+        }
+
+        if(TargetRingAddition._textures.size >= 16) TargetRingAddition._textures.clear();
+
+        const texture = new Texture(BaseTexture.fromBuffer(pixels, width, height, { scaleMode: SCALE_MODES.NEAREST }));
+
+        TargetRingAddition._textures.set(key, texture);
+
+        return texture;
+    }
+
+    public dispose(): void
+    {
+        this._visualization = null;
+        this._asset = null;
+    }
+
+    public update(sprite: IRoomObjectSprite, scale: number): void
+    {
+        if(!sprite) return;
+
+        const small = (scale < 48);
+        const radius = (small ? 10 : 21);
+
+        // The tile's middle, where the shadow is centred: a quarter of the room
+        // scale below the avatar's point, or on it when sitting on furni.
+        const onFurni = ((this._visualization.posture === AvatarAction.POSTURE_SIT) && !this._visualization.canStandUp);
+        const centreY = (onFurni ? 0 : (small ? 8 : 16));
+
+        this._asset = TargetRingAddition.ringTexture(radius, this._colour);
+
+        sprite.visible = true;
+        sprite.texture = this._asset;
+        sprite.offsetX = -radius;
+        sprite.offsetY = (centreY - Math.round(radius / 2));
+        sprite.alpha = 255;
+        sprite.relativeDepth = 0.99;
+    }
+
+    public animate(sprite: IRoomObjectSprite): boolean
+    {
+        if(this._asset && sprite) sprite.texture = this._asset;
+
+        return false;
+    }
+
+    public get id(): number
+    {
+        return this._id;
+    }
+}
